# ==============================================================================
# RESUME ARCHITECT - FASTAPI BACKEND CONFIGURATION
# ==============================================================================

PROJECT_NAME="Resume Architect Central Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8001
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Default fallback: SQLite file database (preserves local development)
DATABASE_URL="sqlite:///./resume_architect.db"

# Supabase PostgreSQL Target (Configure when ready to switch):
# DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Or via Supabase Transaction Pooler (port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# SUPABASE BACKEND INTEGRATION (CONFIDENTIAL - SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"

# ------------------------------------------------------------------------------
# AI ENGINE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
GEMINI_MODEL="gemini-3.8-flash"

# Legacy JWT Settings (used as secondary fallback during authentication migration)
SECRET_KEY="resume_architect_super_secure_jwt_secret_key_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
