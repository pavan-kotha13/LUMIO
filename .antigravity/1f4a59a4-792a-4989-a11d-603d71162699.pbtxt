    end_line: 113
    content: "import React from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Navbar } from \'../components/common/Navbar\';\nimport { Footer } from \'../components/common/Footer\';\nimport { Button } from \'../components/common/Button\';\nimport { Link } from \'react-router-dom\';\nimport { ShieldCheck, CheckCircle2, Terminal, Cpu, ArrowLeft, LogOut } from \'lucide-react\';\n\nexport const AppPreviewPage: React.FC = () => {\n  const { user, logout } = useAuth();\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF8F5] flex flex-col selection:bg-[#1B4332] selection:text-white\">\n      <Navbar />\n\n      <main className=\"flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full\">\n        {/* Foundation Welcome Card */}\n        <div className=\"bg-white rounded-3xl border border-[#E5E1D7] p-8 sm:p-12 shadow-card mb-8\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 border-b border-[#F0ECE1]\">\n            <div className=\"space-y-1\">\n              <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#EBF2EC] text-[#1B4332] text-xs font-semibold\">\n                <ShieldCheck className=\"w-3.5 h-3.5\" />\n                <span>Foundation Initialized</span>\n              </div>\n              <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-[#1C201D]\">\n                Welcome, {user?.name || \'Architect Candidate\'}\n              </h1>\n              <p className=\"text-xs sm:text-sm text-[#57605A]\">\n                Target Mandate: <span className=\"font-semibold text-[#1C201D]\">{user?.targetRole || \'Staff Systems Architect\'}</span> \302\267 Seniority: <span className=\"font-semibold text-[#1C201D]\">{user?.seniority || \'Senior\'}</span>\n              </p>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <Button variant=\"ghost\" size=\"sm\" onClick={() => logout()} leftIcon={<LogOut className=\"w-3.5 h-3.5\" />}>\n                Sign Out\n              </Button>\n              <Link to=\"/\">\n                <Button variant=\"secondary\" size=\"sm\" leftIcon={<ArrowLeft className=\"w-3.5 h-3.5\" />}>\n                  Back to Landing\n                </Button>\n              </Link>\n            </div>\n          </div>\n\n          {/* System Architecture Readiness */}\n          <div className=\"pt-8 space-y-6\">\n            <h2 className=\"text-lg font-bold text-[#1C201D]\">\n              Resume Architect \342\200\224 Project Architecture & Milestone Status\n            </h2>\n            <p className=\"text-sm text-[#57605A] leading-relaxed\">\n              As specified in your instructions, the core foundation, global design system, landing page,\n              login page, and signup page have been successfully established. The system is architected\n              to seamlessly receive the Python FastAPI backend and Gemini AI API in upcoming phases.\n            </p>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-2\">\n              <div className=\"p-5 rounded-2xl bg-[#FAF8F5] border border-[#E5E1D7] space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-[#1B4332] flex items-center gap-1.5\">\n                    <CheckCircle2 className=\"w-4 h-4 text-[#1B4332]\" />\n                    Phase 1: Foundation\n                  </span>\n                  <span className=\"text-[11px] font-mono font-semibold text-[#1B4332] bg-[#EBF2EC] px-2 py-0.5 rounded\">\n                    Ready\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-[#1C201D]\">Design System & Pages</h3>\n                <p className=\"text-xs text-[#57605A]\">\n                  Warm cream canvas, forest green accents, charcoal typography, interactive proof sandbox,\n                  login, and signup flows.\n                </p>\n              </div>\n\n              <div className=\"p-5 rounded-2xl bg-[#FAF8F5] border border-[#E5E1D7] space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-[#1C201D] flex items-center gap-1.5\">\n                    <Terminal className=\"w-4 h-4 text-[#1B4332]\" />\n                    Phase 2: FastAPI Backend\n                  </span>\n                  <span className=\"text-[11px] font-mono text-[#848E88] bg-[#F3EFE7] px-2 py-0.5 rounded\">\n                    Prepared\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-[#1C201D]\">API Client & Services</h3>\n                <p className=\"text-xs text-[#57605A]\">\n                  Typed fetch client at <code className=\"text-[#1B4332]\">src/services/api.ts</code> configured for <code className=\"text-[#1B4332]\">VITE_API_URL</code> endpoints.\n                </p>\n              </div>\n\n              <div className=\"p-5 rounded-2xl bg-[#FAF8F5] border border-[#E5E1D7] space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-[#1C201D] flex items-center gap-1.5\">\n                    <Cpu className=\"w-4 h-4 text-[#1B4332]\" />\n                    Phase 3: Gemini AI\n                  </span>\n                  <span className=\"text-[11px] font-mono text-[#848E88] bg-[#F3EFE7] px-2 py-0.5 rounded\">\n                    Prepared\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-[#1C201D]\">Evidence Extraction</h3>\n                <p className=\"text-xs text-[#57605A]\">\n                  Ready for AI prompt pipelines to deconstruct job specs and synthesize quantified proof dockets.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      <Footer />\n    </div>\n  );\n};\n"
    num_lines: 114
    num_bytes: 5820
    line_range_bytes: 5820
  }
}
