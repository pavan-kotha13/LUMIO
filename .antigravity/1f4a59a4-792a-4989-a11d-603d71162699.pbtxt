border-t border-[#E5E1D7] bg-[#FAF8F5]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Quantitative Proof Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-16\">\n          {metrics.map((m, idx) => (\n            <div\n              key={idx}\n              className=\"bg-white rounded-2xl border border-[#E5E1D7] p-8 shadow-card flex flex-col justify-between\"\n            >\n              <div>\n                <span className=\"text-4xl sm:text-5xl font-bold tracking-tight text-[#1B4332] tabular-nums font-mono block mb-2\">\n                  {m.stat}\n                </span>\n                <h3 className=\"text-base font-bold text-[#1C201D] mb-2\">{m.label}</h3>\n                <p className=\"text-xs text-[#57605A] leading-relaxed\">{m.context}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Attributable Case Studies */}\n        <div className=\"max-w-3xl mb-8\">\n          <p className=\"text-xs font-semibold tracking-wider uppercase text-[#1B4332] mb-2\">\n            Real Career Transitions\n          </p>\n          <h2 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-[#1C201D]\">\n            From the other side of the hiring table\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {testimonials.map((t, idx) => (\n            <div\n              key={idx}\n              className=\"bg-white rounded-2xl border border-[#E5E1D7] p-8 shadow-card flex flex-col justify-between\"\n            >\n              <blockquote className=\"text-sm text-[#1C201D] leading-relaxed mb-6 italic\">\n                \"{t.quote}\"\n              </blockquote>\n\n              <div className=\"pt-6 border-t border-[#F0ECE1] flex items-start justify-between\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-[#1C201D]\">{t.author}</h4>\n                  <p className=\"text-xs text-[#57605A]\">{t.role}</p>\n                  <p className=\"text-xs text-[#848E88] mt-0.5\">{t.previous}</p>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"text-[11px] font-semibold text-[#1B4332] bg-[#EBF2EC] px-2.5 py-1 rounded\">\n                    {t.verifiedTransition}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
