      thinking_signature: "\022\362\020\n\357\020\001i\024}\023?I\311)[\313W\036\032\244\'\357\251b\237Vy\323K,D\027e\242b\274\036\325\240zt\224\307\303z\334\244\243\021\312b$\220}3\376:\273\236\361y$xz\255\353\315R\201d\244yr\337:\\\021\220\312\273j\224\322\376\2342\241&\264\362%\030\300\264\260\n\243\223-?;}y1&\355\004\316\302\302\341\244\255X\\\032\244\004\303\240\247\277Y\250\213#.\326\350\330A\263\231\211H\001yH\320\224\267\227\022\335\227W\023+\366B^\251n\223rB\275\356t\a\004\3449\025\205\022\221+\260\336\210s\227kc\317\217\270U8\306k\210\030\002\217\253\\\332\232@\n\240\v\247\221X\316pp\356\264\226j\337\263.\201\241\361\223\275\246)\207\024\003\222C*Dx\204\b\377\016\233\254\031<\321\233>\273$@\0257\323\334\302r\t\264C\f\224\300\365\244m\210\201\335\306.\211x\0334\035\"p,D\231\021\206\323v\335t\254M\302\353\023\t\202\236d\333O\206,\350\003Y\030\035o\r\231Z\303\347[\371\006\244S\267_[0\037\326\356\322\2378\001\275\264\364\3764\032H>u\260\034\377\217\fC\250Su\024\324\177\376\236\2257\347\311t\342\363\277a\216Q@\023\336\005\316\312\366\3344IN\323k\017R\237XrWv\\\372\310\352n]\340Y\224\2254\372k\236\243\242!6\224\241\325iX#\030\200{\331Pj\006\2233({5o\242@xAd\314\004M\021\006M\3435\212|\366\200\370\005$NG\006\245\265C\331\331\004\362?G\361\304\375\202 l@\244j\r\314\355\r\275\336A\340\270\306S\332\031\373\313\314\355Ax\324t98}\247\216\351d\020\300id\006A7{<\367\203Sn\n\242\337\345\242\205W_\224z%3C\202J\321fB\342\035\3459b?\212\332X\204\254\016\024\030\3204p0\356\273\n\3570!\373\325\346\270g\003\231l\303\241\270\317\314D8-/\020\v\201\032\267\203\260\263\306\271d\222x\037[\277\305\336\345!3)\204\204\354\317\255\205i\344*\360\265\370\232\\\313\322s2i\254M\357\336-o7\314\235\200\331=\236\372V\230g\005~\025\216\311\344v\315P\216\337\256\217\020\006J\342\310$\360t\215K\206\213\204NN\fc\216\317(6\257\020\030\323*\320\271\371vy\237\202\267@\265\324$\354n\032\327\223\311\006\273]\367\355G\030\224\272X\217T\274C]\266\324\2766\365\005\260\276c\266v\336\254\231k\327\370\205\271\ve\275\322,\244=H*\324\332\211\274\330\255\r\262\324l\")\031.\026\341-\236\340\300\305\253\263\031BO\205\371Z\2730\027\f\215\'\227\'\212^2\020\374\220\005C?\034\326\tm\276\257FL\261\025y\373\016\033\360B\374}\255\003\236\020f\346\310\f\362\243\b\003*\372E\016\270V.A\226\204\250\376\365\240\204z\333\242E\217ihN\341\272+\270\243\226\037\311\006\271\231\243G+o\"\357\305fN?\332\341o\321\367a\337S\236\330\232$I[-\344\325ui\333[3\204\262w.kp\276\317\215{\333\352\261/](\322\'M\377\a\236\347\365\314\032\232W!\223y\365\205\230\203\304}\333 \t\330Z\36440\353F>\332\020z \3545VS\234\270\350T5\025\221?a\201~\032\034\343lW\017D!\220\230\331\247\332\334\222\234<=N\347RY|HF\344\r#xy\362\243A\351\f\006?\315\367M\377\021kI\340\bt\334\270\365\333 XH3h\326\037cp\364\v\036\363C\334y7\\L\352}S\332}\260\270#y\004\022\255\250\235\v\244H@\343\266pA\023\371\"\'\217!\362\246\2141\000\035\331\247i^\202\345KO\333\254\314\022\267O\314\364\210{3\210\002\022\304\310:\001\244lI\217H\030}\0321h\315\205\034\203\226J\346\201m\220\232&\306?h\206N\036P\247\032\347\037#\221*d\275y\362\3268\344\205\347\016\341\024S\005c/\t&\327\360#vm\230)\326?\377\351f\373R\372l\t\035v\230%?\b\a\341h\025\271\234\217\326Q\222\334\332\347\221]\'3\031\256 \331\270\246\337bGv\247\v\222\225\356o\326\311\017\t\270\2444\022L\326\321\231\344\310\367\326\217\313e\271n\333Ihmp\206\362\226Ik\266]\266+<OY\032M1=Q\003\324;\256\224+\nK;\302?\377\306\346\"\351t\242\247\231\312\330\307\376\241\306\272\306H\033\\}\3220\322\277\360u\005\375\302\247\263\215q\356\322\230:\217\364\354V\316\207n,\314H\367\322\326\034TV\235\375h\277\327\355P\033k-\341[\364\210\254\324\241\220r\220\006\221X\005\254y\300V\023\034\036\376\307\375\005&\304\216\203\335\220\346L\274\344\272$\227\227}<\230\357\217\211i\254n\363\3129./\006\327axY\006\315\033\210n\306\373/+\360\366@\351\002\217\231\201\v\353\313\305\222\022\033\177\327\307\327\256\324\000\302\222\220\331\201\365\365\344\300P\275F\033^\370\027\336\375%\245y\211\016z\222\350\357}\314\3402&\303\266\375\323\332\232\222\326km)!\210[\235X7>\242A\343\3335\254\324Ks`\002\335\020\364\022\336\327\aN\303-\366f\355\306\236-\b.P\220\242\371I\022\203-2\365\006w${\274\3134\272\310K\362\207o\353\314n\346\364\245\245\271\372\035E\241\v\036\005\2377\334P~\261\214\n5\314\216\334{\353VP:$_\361^\212\252\370R[^\212_?MK}\000M\206Q\221\342\253\3464\236\205(i\226\006~\340P\263Zi8kt\272\'\037\354\273\317\357\256\3308\264\224\273|\352\361\205vq\200=\260\035$\252\301\364\200\332{ST\366]8k!\027z{\220;e\240g\265\r\262s\005\326\243\367\277h y\031\325\ahb3\240\360\355\213\316\334\316N7\321\334\"1\037\336<\317E\345\215\335\001g\243\240I>g\214\271\367\'\020\200\016\033\370\005\204\322*\004k4B\222\275\350\256\020\023\026y\367\254\225\327|\367\211!\231\002\257\3119\002x\237\005\000\320$O\n\024\342\347\231\255[\272\016i\213\232\321W|Q9\220w\362\276\251\376\233\371|\325\016\247L\223n\005\337\000\vhA\247\256\tp3\005\211\023\262\351\257\316w\251\214\224p\374\2167\346\273\265\r\342|\255\336\241dq\276\'%{BWu\030\023\320\260Wk\313\357Ck]\2624v\300S\026\355\375zK\225yP\312\226\305R?\000\337\252f\032N\250\316\215\357#\032\354\322p\320\n\222\221\304^\235\002J\t-\220I\207H\373\233\255\023\227\034\254\377\2631w\004\327\322{\251y\227u}\366\340aw\346E\245\342\233\223G%*\241\360\234\204Z\206_\350\377\335bvZ\224&\216J\2450\310\352\f\\:\302(\016\025\031\033\252\330\270\312D\336\345 v\247+\323\216ll\315\\oEu\355\260\032mL1f\365\034]\213\263\232\340\260\230\3654:\223\220\255\217\320\303\b\216\375R\t\006H\n\216\034d\331\335\277+[PF[\222\346Ye\226\334\373\330>\t\271\223\341\241\360\304=rb\332\315;\377\354F\a2\320\360\367\030\230\035\224:\272\0008\177\276\304y@vR#(V|9C\0317J\002\250\263\246\024^\350\vO]\252\273\177\\J\274\023\227\220\357\264B\256\225E\f\fr\271?H\340\003\206\2736,b\334\005\336\224=\311\225$\207t\227p\236\302s\0275\020\033t\207a3\373k\232\032j\234\277\003C#\226e\277\2514I,\246\001U\254\373GI\023\377\236\264\"\370\353\341\323\3108\v\234(\201d\342 \333\273\3220^e)\241u\274J-)=\314\331\310\331\2224$\370\023\367\310\304\363nrl\213S\037F\326\345\v\004\216@\3233A\001\357\343sMY3z\001y\360\236\205\215w\016\323\'G\310\316\366\023\234\021e\035\2517\'H\003\236"
