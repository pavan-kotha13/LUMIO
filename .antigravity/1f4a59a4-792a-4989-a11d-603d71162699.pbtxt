              text: "    \"experience_relevance\": 0.15,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"education_relevance\": 0.05,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"formatting_readability\": 0.10,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "STOP_WORDS = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"and\", \"the\", \"to\", \"of\", \"a\", \"in\", \"for\", \"is\", \"on\", \"that\", \"by\", \"this\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"with\", \"i\", \"you\", \"it\", \"not\", \"or\", \"be\", \"are\", \"from\", \"at\", \"as\", \"your\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"all\", \"have\", \"new\", \"more\", \"an\", \"was\", \"we\", \"will\", \"home\", \"can\", \"us\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"about\", \"if\", \"page\", \"my\", \"has\", \"search\", \"free\", \"but\", \"our\", \"one\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"other\", \"do\", \"no\", \"information\", \"time\", \"they\", \"site\", \"he\", \"up\", \"may\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"what\", \"which\", \"their\", \"news\", \"out\", \"use\", \"any\", \"there\", \"see\", \"only\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"so\", \"his\", \"when\", \"contact\", \"here\", \"business\", \"who\", \"web\", \"also\", \"now\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"help\", \"get\", \"pm\", \"view\", \"online\", \"c\", \"e\", \"first\", \"am\", \"been\", \"would\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"how\", \"were\", \"me\", \"s\", \"services\", \"some\", \"these\", \"click\", \"its\", \"like\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"service\", \"x\", \"than\", \"find\", \"price\", \"date\", \"back\", \"top\", \"people\", \"had\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"list\", \"name\", \"just\", \"over\", \"state\", \"year\", \"day\", \"into\", \"email\", \"two\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"health\", \"n\", \"re\", \"next\", \"used\", \"go\", \"b\", \"work\", \"last\", \"most\", \"products\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"music\", \"buy\", \"data\", \"make\", \"them\", \"should\", \"product\", \"system\", \"post\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"her\", \"city\", \"t\", \"add\", \"policy\", \"number\", \"such\", \"please\", \"available\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"copyright\", \"support\", \"message\", \"after\", \"best\", \"software\", \"then\", \"jan\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"good\", \"video\", \"well\", \"d\", \"where\", \"info\", \"rights\", \"public\", \"books\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"high\", \"school\", \"through\", \"m\", \"each\", \"links\", \"she\", \"review\", \"years\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"order\", \"very\", \"privacy\", \"book\", \"items\", \"company\", \"r\", \"read\", \"group\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"need\", \"many\", \"user\", \"said\", \"de\", \"does\", \"set\", \"under\", \"general\", \"research\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"university\", \"january\", \"mail\", \"full\", \"map\", \"reviews\", \"program\", \"life\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "def extract_keywords(text: str) -> List[str]:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"\"\"Extract distinct meaningful keywords from text.\"\"\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tokens = re.findall(r\'\\b[a-zA-Z0-9+#.-]{2,30}\\b\', text.lower())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    clean = []"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    seen = set()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for t in tokens:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if t not in STOP_WORDS and not t.isdigit() and len(t) > 2:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if t not in seen:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                seen.add(t)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                clean.append(t)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return clean"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "def compute_deterministic_score("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    resume_text: str,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    job_description: str,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    skills_list: List[str] = None,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    experience_list: List[Dict[str, Any]] = None,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    projects_list: List[Dict[str, Any]] = None,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    education_list: List[Dict[str, Any]] = None"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ") -> Dict[str, Any]:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"\"\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Computes deterministic Resume Architect Score across the 6 strictly defined pillars."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"\"\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    resume_lower = resume_text.lower()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    jd_lower = job_description.lower()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    jd_keywords = extract_keywords(job_description)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    resume_keywords = set(extract_keywords(resume_text))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 1. Technical Skills Alignment (Weight: 30%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tech_skills_seed = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"python\", \"javascript\", \"typescript\", \"react\", \"node\", \"sql\", \"postgresql\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"mongodb\", \"aws\", \"docker\", \"kubernetes\", \"git\", \"ci/cd\", \"rest\", \"graphql\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"java\", \"c++\", \"c#\", \"go\", \"rust\", \"html\", \"css\", \"tailwind\", \"fastapi\", \"django\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"flask\", \"next.js\", \"express\", \"linux\", \"agile\", \"scrum\", \"microservices\", \"unit testing\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"redis\", \"kafka\", \"pandas\", \"numpy\", \"pytorch\", \"tensorflow\", \"machine learning\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # Extract technical skills required by JD"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    jd_tech_skills = [s for s in tech_skills_seed if s in jd_lower]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if not jd_tech_skills:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        # Fallback to general tech keywords in JD"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        jd_tech_skills = [k for k in jd_keywords if len(k) > 3][:12]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    matched_tech = [s for s in jd_tech_skills if s in resume_lower or (skills_list and any(s in x.lower() for x in skills_list))]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    skills_score = round(min(100.0, (len(matched_tech) / max(1, len(jd_tech_skills))) * 100.0), 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 2. Keyword Alignment (Weight: 20%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sample_jd_keywords = jd_keywords[:30] if len(jd_keywords) >= 30 else jd_keywords"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    matched_keywords = [k for k in sample_jd_keywords if k in resume_keywords or k in resume_lower]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    keyword_score = round(min(100.0, (len(matched_keywords) / max(1, len(sample_jd_keywords))) * 100.0), 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 3. Project Relevance (Weight: 20%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # Checks if projects exist and reference relevant technologies or outcomes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    has_projects = bool(projects_list or \"project\" in resume_lower)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    project_matches = 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if projects_list:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for p in projects_list:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            p_text = f\"{p.get(\'title\', \'\')} {\' \'.join(p.get(\'technologies\', []))} {\' \'.join(p.get(\'bullets\', []))}\".lower()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if any(k in p_text for k in jd_tech_skills):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                project_matches += 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        project_ratio = project_matches / max(1, len(projects_list))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        project_score = round(min(100.0, 40.0 + (project_ratio * 60.0)), 1) if projects_list else 40.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    elif has_projects:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        # Check mentions in text"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        relevant_mentions = sum(1 for s in jd_tech_skills if s in resume_lower)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        project_score = round(min(100.0, 50.0 + (relevant_mentions / max(1, len(jd_tech_skills))) * 50.0), 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    else:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        project_score = 35.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 4. Experience Relevance (Weight: 15%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # Experience length, active verbs, relevance to target domain"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    experience_verbs = [\"developed\", \"engineered\", \"designed\", \"architected\", \"implemented\", \"delivered\", \"optimized\", \"managed\", \"led\", \"reduced\", \"increased\"]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    verbs_count = sum(1 for v in experience_verbs if v in resume_lower)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    exp_has_years = bool(re.search(r\'\\b(20\\d\\d|19\\d\\d|\\d+\\+?\\s*years?)\\b\', resume_lower))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    exp_factor = min(1.0, (verbs_count / 6.0))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    experience_score = round(min(100.0, 50.0 + (exp_factor * 35.0) + (15.0 if exp_has_years else 0.0)), 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 5. Education Relevance (Weight: 5%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    edu_terms = [\"bachelor\", \"master\", \"phd\", \"degree\", \"computer science\", \"engineering\", \"b.tech\", \"b.s.\", \"m.s.\", \"university\", \"college\"]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    found_edu = sum(1 for e in edu_terms if e in resume_lower)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    education_score = 100.0 if found_edu >= 3 else (80.0 if found_edu >= 1 else 50.0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # 6. Formatting and Readability (Weight: 10%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # Clear section headers, contact info presence, bullet length"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    has_email = bool(re.search(r\'[\\w.-]+@[\\w.-]+\\.\\w+\', resume_text))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    has_phone = bool(re.search(r\'(\\+?\\d{1,3}[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\', resume_text))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    has_headers = any(h in resume_lower for h in [\"experience\", \"education\", \"skills\", \"projects\", \"summary\"])"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    formatting_points = 40.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if has_email: formatting_points += 20.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if has_phone: formatting_points += 15.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if has_headers: formatting_points += 25.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    formatting_score = min(100.0, formatting_points)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    # Calculate weighted total"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    overall_score = round("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (skills_score * WEIGHTS[\"technical_skills\"]) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (keyword_score * WEIGHTS[\"keyword_alignment\"]) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (project_score * WEIGHTS[\"project_relevance\"]) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (experience_score * WEIGHTS[\"experience_relevance\"]) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (education_score * WEIGHTS[\"education_relevance\"]) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (formatting_score * WEIGHTS[\"formatting_readability\"]),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categories = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"id\": \"technical-skills\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"name\": \"Technical Skill Alignment\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"score\": skills_score,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"weight\": 0.30,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"status\": \"optimal\" if skills_score >= 80 else (\"moderate\" if skills_score >= 60 else \"action-required\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"summary\": f\"Detected {len(matched_tech)} of {len(jd_tech_skills)} core technical skills required in the job description.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"metrics\": {\"matched\": len(matched_tech), \"total\": len(jd_tech_skills), \"unit\": \"skills\"}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"id\": \"keyword-alignment\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"name\": \"Job Description Keyword Alignment\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"score\": keyword_score,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"weight\": 0.20,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"status\": \"optimal\" if keyword_score >= 80 else (\"moderate\" if keyword_score >= 60 else \"action-required\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"summary\": f\"Matched {len(matched_keywords)} out of {len(sample_jd_keywords)} primary industry keywords from the job posting.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"metrics\": {\"matched\": len(matched_keywords), \"total\": len(sample_jd_keywords), \"unit\": \"keywords\"}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"id\": \"project-relevance\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"name\": \"Project Relevance & Scope\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"score\": project_score,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"weight\": 0.20,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"status\": \"optimal\" if project_score >= 80 else (\"moderate\" if project_score >= 60 else \"action-required\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"summary\": \"Evaluates project technical stack, complexity, and hands-on relevance to the target job specification.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"metrics\": {\"matched\": int(project_score * 0.1), \"total\": 10, \"unit\": \"points\"}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"id\": \"experience-relevance\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"name\": \"Work Experience Relevance\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"score\": experience_score,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
