      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Link, useNavigate, useLocation } from \'react-router-dom\';\nimport { Logo } from \'./Logo\';\nimport { Button } from \'./Button\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { Menu, X, ArrowUpRight } from \'lucide-react\';\n\nexport const Navbar: React.FC = () => {\n  const { user, isAuthenticated, logout } = useAuth();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const navigate = useNavigate();\n  const location = useLocation();\n\n  const isAuthPage = location.pathname === \'/login\' || location.pathname === \'/signup\';\n\n  const handleNavClick = (sectionId: string) => {\n    setMobileMenuOpen(false);\n    if (location.pathname !== \'/\') {\n      navigate(\'/\' + sectionId);\n      return;\n    }\n    const element = document.querySelector(sectionId);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-[#E5E1D7] transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-8 h-16\">\n          {/* Zone 1: Single brand wordmark */}\n          <div className=\"shrink-0 flex items-center\">\n            <Logo />\n          </div>\n\n          {/* Zone 2: 4-5 concise single-line nav links */}\n          {!isAuthPage ? (\n            <nav className=\"hidden md:flex items-center gap-7 text-sm font-medium text-[#57605A]\">\n              <button\n                onClick={() => handleNavClick(\'#methodology\')}\n                className=\"hover:text-[#1C201D] transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                Methodology\n              </button>\n              <button\n                onClick={() => handleNavClick(\'#proof-engine\')}\n                className=\"hover:text-[#1C201D] transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                Proof Engine\n              </button>\n              <button\n                onClick={() => handleNavClick(\'#comparison\')}\n                className=\"hover:text-[#1C201D] transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                Match vs. Prove\n              </button>\n              <button\n                onClick={() => handleNavClick(\'#pricing\')}\n                className=\"hover:text-[#1C201D] transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                Pricing\n              </button>\n            </nav>\n          ) : (\n            <div className=\"hidden md:block text-xs text-[#57605A]\">\n              Don\'t just match the job. Prove your fit.\n            </div>\n          )}\n\n          {/* Zone 3: 1 primary action */}\n          <div className=\"hidden md:flex items-center gap-3 shrink-0\">\n            {isAuthenticated ? (\n              <div className=\"flex items-center gap-3\">\n                <Link to=\"/app\">\n                  <Button variant=\"secondary\" size=\"sm\">\n                    Workspace ({user?.name.split(\' \')[0]})\n                  </Button>\n                </Link>\n                <Button variant=\"ghost\" size=\"sm\" onClick={() => logout()}>\n                  Sign Out\n                </Button>\n              </div>\n            ) : isAuthPage ? (\n              location.pathname === \'/login\' ? (\n                <Link to=\"/signup\">\n                  <Button variant=\"primary\" size=\"sm\">\n                    Create Account\n                  </Button>\n                </Link>\n              ) : (\n                <Link to=\"/login\">\n                  <Button variant=\"secondary\" size=\"sm\">\n                    Sign In\n                  </Button>\n                </Link>\n              )\n            ) : (\n              <div className=\"flex items-center gap-2.5\">\n                <Link to=\"/login\">\n                  <Button variant=\"ghost\" size=\"sm\">\n                    Sign In\n                  </Button>\n                </Link>\n                <Link to=\"/signup\">\n                  <Button\n                    variant=\"primary\"\n                    size=\"sm\"\n                    rightIcon={<ArrowUpRight className=\"w-3.5 h-3.5\" />}\n                  >\n                    Start Architecting\n                  </Button>\n                </Link>\n              </div>\n            )}\n          </div>\n\n          {/* Mobile hamburger button */}\n          <div className=\"flex md:hidden items-center\">\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 text-[#1C201D] hover:bg-[#F3EFE7] rounded-lg transition-colors\"\n              aria-label=\"Toggle navigation menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile drawer */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-b border-[#E5E1D7] bg-[#FAF8F5] px-4 pt-3 pb-6 space-y-3\">\n          <nav className=\"flex flex-col space-y-2 text-sm font-medium text-[#1C201D]\">\n            <button\n              onClick={() => handleNavClick(\'#methodology\')}\n              className=\"text-left py-2 px-3 rounded-md hover:bg-[#F3EFE7] transition-colors\"\n            >\n              Methodology\n            </button>\n            <button\n              onClick={() => handleNavClick(\'#proof-engine\')}\n              className=\"text-left py-2 px-3 rounded-md hover:bg-[#F3EFE7] transition-colors\"\n            >\n              Proof Engine\n            </button>\n            <button\n              onClick={() => handleNavClick(\'#comparison\')}\n              className=\"text-left py-2 px-3 rounded-md hover:bg-[#F3EFE7] transition-colors\"\n            >\n              Match vs. Prove\n            </button>\n            <button\n              onClick={() => handleNavClick(\'#pricing\')}\n              className=\"text-left py-2 px-3 rounded-md hover:bg-[#F3EFE7] transition-colors\"\n            >\n              Pricing\n            </button>\n          </nav>\n          <div className=\"pt-3 border-t border-[#E5E1D7] flex flex-col gap-2\">\n            {isAuthenticated ? (\n              <>\n                <Link to=\"/app\" onClick={() => setMobileMenuOpen(false)}>\n                  <Button variant=\"primary\" size=\"md\" className=\"w-full\">\n                    Open Workspace\n                  </Button>\n                </Link>\n                <Button\n                  variant=\"ghost\"\n                  size=\"md\"\n                  className=\"w-full\"\n                  onClick={() => {\n                    logout();\n                    setMobileMenuOpen(false);\n                  }}\n                >\n                  Sign Out\n                </Button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/signup\" onClick={() => setMobileMenuOpen(false)}>\n                  <Button variant=\"primary\" size=\"md\" className=\"w-full\">\n                    Start Architecting\n                  </Button>\n                </Link>\n                <Link to=\"/login\" onClick={() => setMobileMenuOpen(false)}>\n                  <Button variant=\"secondary\" size=\"md\" className=\"w-full\">\n                    Sign In\n                  </Button>\n                </Link>\n              </>\n            )}\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/common/Navbar.tsx"
        }
        overwrite: true
      }
    }
