            }
            lines {
              text: "* **Surfaces**: Crisp white (`#FFFFFF`) and warm surface (`#FAF8F5`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "* **Primary Accent**: Forest Green (`#1B4332`, hover `#143627`, tints `#EBF2EC`, `#2D6A4F`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "* **Charcoal Text**: Primary (`#1C201D`), Muted (`#57605A`), Subtle (`#848E88`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "* **Subtle Borders**: `#E5E1D7` (light grey / sand hairline)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "* **Shadows**: Subtle, crisp card shadows (`shadow-card`, `shadow-subtle`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "* **Typography**: Plus Jakarta Sans for clean readability, monospace tabular figures for scores."
