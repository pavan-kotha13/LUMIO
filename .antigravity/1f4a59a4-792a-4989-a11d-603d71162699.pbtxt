      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { Navbar } from \'../components/common/Navbar\';\nimport { Footer } from \'../components/common/Footer\';\nimport { Input } from \'../components/common/Input\';\nimport { Button } from \'../components/common/Button\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Mail, Lock, User as UserIcon, Briefcase, ArrowRight, ShieldCheck, CheckCircle2, AlertCircle } from \'lucide-react\';\n\nexport const SignupPage: React.FC = () => {\n  const [name, setName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [targetRole, setTargetRole] = useState(\'Staff Software Architect\');\n  const [seniority, setSeniority] = useState(\'Senior\');\n  const [agreeTerms, setAgreeTerms] = useState(true);\n  const [formError, setFormError] = useState<string | null>(null);\n\n  const { signup, isLoading, error, clearError } = useAuth();\n  const navigate = useNavigate();\n\n  // Password strength calculation\n  const getPasswordStrength = (pass: string) => {\n    if (!pass) return { score: 0, label: \'Empty\' };\n    let score = 0;\n    if (pass.length >= 8) score++;\n    if (/[A-Z]/.test(pass)) score++;\n    if (/[0-9]/.test(pass)) score++;\n    if (/[^A-Za-z0-9]/.test(pass)) score++;\n\n    if (score <= 1) return { score: 1, label: \'Weak\', color: \'bg-red-400\' };\n    if (score === 2) return { score: 2, label: \'Fair\', color: \'bg-amber-400\' };\n    if (score === 3) return { score: 3, label: \'Good\', color: \'bg-emerald-500\' };\n    return { score: 4, label: \'Strong\', color: \'bg-[#1B4332]\' };\n  };\n\n  const strength = getPasswordStrength(password);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    clearError();\n    setFormError(null);\n\n    if (!name.trim()) {\n      setFormError(\'Please enter your full name.\');\n      return;\n    }\n\n    if (!email || !email.includes(\'@\')) {\n      setFormError(\'Please enter a valid email address.\');\n      return;\n    }\n\n    if (!password || password.length < 8) {\n      setFormError(\'Password must be at least 8 characters.\');\n      return;\n    }\n\n    if (!agreeTerms) {\n      setFormError(\'Please accept the Terms of Service to continue.\');\n      return;\n    }\n\n    try {\n      await signup({\n        name,\n        email,\n        password,\n        targetRole,\n        seniority,\n      });\n      navigate(\'/app\');\n    } catch {\n      // Handled in context\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF8F5] flex flex-col selection:bg-[#1B4332] selection:text-white\">\n      <Navbar />\n\n      <main className=\"flex-1 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8\">\n        <div className=\"w-full max-w-4xl bg-white rounded-3xl border border-[#E5E1D7] shadow-card overflow-hidden grid grid-cols-1 md:grid-cols-12\">\n          {/* Left Brand Panel */}\n          <div className=\"md:col-span-5 bg-[#1B4332] text-white p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden\">\n            <div className=\"absolute inset-0 opacity-10 pointer-events-none\">\n              <svg className=\"w-full h-full\" xmlns=\"http://www.w3.org/2000/svg\">\n                <rect x=\"20\" y=\"20\" width=\"160\" height=\"160\" stroke=\"#FFF\" strokeWidth=\"1\" fill=\"none\" />\n                <path d=\"M20 100 L180 100\" stroke=\"#FFF\" strokeWidth=\"1\" />\n                <path d=\"M100 20 L100 180\" stroke=\"#FFF\" strokeWidth=\"1\" />\n              </svg>\n            </div>\n\n            <div className=\"relative z-10 space-y-6\">\n              <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-white/10 text-xs font-medium tracking-wide\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-[#A3C4B0]\" />\n                <span>The Architecture Standard</span>\n              </div>\n\n              <div>\n                <h2 className=\"text-2xl font-bold tracking-tight text-white leading-snug\">\n                  Build your career dossier on verified impact.\n                </h2>\n                <p className=\"text-xs text-[#D5E3DA] mt-3 leading-relaxed\">\n                  Join candidates who refuse to rely on shallow keyword spam. We extract your\n                  true scale, architecture decisions, and business results into bulletproof proof dockets.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"relative z-10 pt-8 border-t border-white/15 space-y-2 text-xs text-[#D5E3DA]\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-[#A3C4B0] shrink-0\" />\n                <span>Zero AI fluff or hallucinated skills</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-[#A3C4B0] shrink-0\" />\n                <span>Tailored for human hiring committees</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-[#A3C4B0] shrink-0\" />\n                <span>Instant ATS semantic compliance</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Form Panel */}\n          <div className=\"md:col-span-7 p-8 sm:p-12 flex flex-col justify-between bg-white\">\n            <div>\n              <div className=\"space-y-1 mb-8\">\n                <h1 className=\"text-2xl font-bold tracking-tight text-[#1C201D]\">\n                  Create Your Candidate Account\n                </h1>\n                <p className=\"text-xs text-[#57605A]\">\n                  Configure your target mandate and start excavating proof points.\n                </p>\n              </div>\n\n              {(formError || error) && (\n                <div className=\"mb-6 p-3 bg-red-50 rounded-lg border border-red-200 text-xs text-red-700 flex items-start gap-2\">\n                  <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n                  <span>{formError || error}</span>\n                </div>\n              )}\n\n              <form onSubmit={handleSubmit} className=\"space-y-4\">\n                <Input\n                  label=\"Full Legal / Professional Name\"\n                  type=\"text\"\n                  placeholder=\"e.g. Sarah Lindqvist\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  leftIcon={<UserIcon className=\"w-4 h-4\" />}\n                  required\n                />\n\n                <Input\n                  label=\"Primary Work Email\"\n                  type=\"email\"\n                  placeholder=\"sarah.lindqvist@domain.com\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  leftIcon={<Mail className=\"w-4 h-4\" />}\n                  required\n                />\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <Input\n                    label=\"Target Role Title\"\n                    type=\"text\"\n                    placeholder=\"Staff Eng, VP Product...\"\n                    value={targetRole}\n                    onChange={(e) => setTargetRole(e.target.value)}\n                    leftIcon={<Briefcase className=\"w-4 h-4\" />}\n                    required\n                  />\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-xs font-semibold text-[#1C201D]\">\n                      Seniority Tier\n                    </label>\n                    <select\n                      value={seniority}\n                      onChange={(e) => setSeniority(e.target.value)}\n                      className=\"w-full bg-white text-[#1C201D] text-sm border border-[#E5E1D7] rounded-lg px-3 py-2.5 outline-none focus:border-[#1B4332] focus:ring-1 focus:ring-[#1B4332] shadow-subtle cursor-pointer\"\n                    >\n                      <option value=\"Mid\">Mid-Level (3-5 yrs)</option>\n                      <option value=\"Senior\">Senior Specialist (5-8 yrs)</option>\n                      <option value=\"Lead\">Lead / Staff / Principal</option>\n                      <option value=\"Director\">Director / Head of Dept</option>\n                      <option value=\"Executive\">VP / C-Level Executive</option>\n                    </select>\n                  </div>\n                </div>\n\n                <div className=\"space-y-2\">\n                  <Input\n                    label=\"Master Password\"\n                    type=\"password\"\n                    placeholder=\"Minimum 8 characters\"\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    leftIcon={<Lock className=\"w-4 h-4\" />}\n                    required\n                  />\n\n                  {password && (\n                    <div className=\"space-y-1 pt-1\">\n                      <div className=\"flex items-center justify-between text-[11px] text-[#57605A]\">\n                        <span>Password strength:</span>\n                        <span className=\"font-semibold\">{strength.label}</span>\n                      </div>\n                      <div className=\"w-full h-1.5 bg-[#E5E1D7] rounded-full overflow-hidden\">\n                        <div\n                          className={`h-full transition-all duration-300 ${strength.color}`}\n                          style={{ width: `${(strength.score / 4) * 100}%` }}\n                        />\n                      </div>\n                    </div>\n                  )}\n                </div>\n\n                <div className=\"pt-1\">\n                  <label className=\"flex items-start gap-2.5 cursor-pointer text-xs text-[#57605A]\">\n                    <input\n                      type=\"checkbox\"\n                      checked={agreeTerms}\n                      onChange={(e) => setAgreeTerms(e.target.checked)}\n                      className=\"mt-0.5 rounded border-[#E5E1D7] text-[#1B4332] focus:ring-[#1B4332] w-4 h-4\"\n                    />\n                    <span>\n                      I agree to the Terms of Service and Privacy Policy. My career data remains\n                      strictly confidential and is never sold.\n                    </span>\n                  </label>\n                </div>\n\n                <div className=\"pt-2\">\n                  <Button\n                    type=\"submit\"\n                    variant=\"primary\"\n                    size=\"lg\"\n                    className=\"w-full\"\n                    isLoading={isLoading}\n                    rightIcon={<ArrowRight className=\"w-4 h-4\" />}\n                  >\n                    Create Workspace & Enter\n                  </Button>\n                </div>\n              </form>\n            </div>\n\n            <div className=\"mt-8 pt-6 border-t border-[#F0ECE1] text-center text-xs text-[#57605A]\">\n              Already have an account?{\' \'}\n              <Link to=\"/login\" className=\"text-[#1B4332] font-semibold hover:underline\">\n                Sign In\n              </Link>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      <Footer />\n    </div>\n  );\n};\n"
