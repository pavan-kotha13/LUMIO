              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const allSkillsCount = (skills.technical?.length || 0) + (skills.softAndTools?.length || 0);"
