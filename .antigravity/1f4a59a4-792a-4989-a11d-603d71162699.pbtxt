      thinking_signature: "\022\317\017\n\314\017\001i\024}\023\357\223\203\324iw\030\340\372\026\254\033\252\335\300\2436\006%\3443\303I\327\311%\000\302d\310G\021]\273\267\275\235\344\025\032\004 X)\352\344(l\227+\240`g\016Lc\241\023n\335\'6\275\370\v_\345\333\240\243\373\345\330E\323Ov\257%\311# \305u\020\357+g\017^\022\346\311`\242c1_0\177\177\023\312\001\317\333\0236I\341\245\3504\2453\030\365G94\325\356\364\300\353k\250$\212J\302\336\351\316\274\276\252\301\270\217p\356h\232I\017\021NW\347\355M\2058\303\207\2446\366w\032\361\351\267+\240\246?n\230\024\343\254%@\221\367r\357\034\223\325\356hJ\324\021\272\024\344i\326\215\246\2713Z\244\230\236\277\375\bU\262|d\235Z_q\204^O\332)\246\276)\314v\272k=rc\240\037\314TH\005\346\310\336\375\v|L#h\221\2718\363\254\214\004\006\016\245]h\314x\333\036n\231D\225\336\225m9\r\330\246Q\354\024\004\337\344~\271p\b\303\003\"\363o\257i\227\357e\363\211\034\tM\256\243=\303\002f\177\3100B/2\021u\256\027W\003\224\r h\374\376!/\022\253:\"\355\\\376G\324\252$\357#\254\001\303\030,\"]=\223Blm\025\215\234\310t\220\3658t7\256\200\356\001K\206\276\375\321\310\305\027\257P\317\334\335P\273}Q<\261\315\207\334e+Wl\314\326\v\001O\020\213\ab\365D\t]\277\177\236\253/\220rf\241\210K\'f\246\336\n\203\215\022\224R\216\244K\321(\331)|\vV\335\026 \215\302\345G\317\331\r\235\364\323\3538\036\001hS\316A\263vb\017\313e\016\026R\352d\376N\226\246\216\274\232\020\035O\230\325@\203\005\376W\311\271\211\001\031\325/\023q\032\204\203{\300z^\247\006T.\377\327H\000\343To\354\207\312W\243\353\f5D\273\267\324\213<\022\335\\\245\241\346\v\3703\236\376<6\273\222\212\260\332j\344ap\350Q\341>\350\005\271P^\026\256b\345\315\364\035\314\204\032[\300X\264Z\022\277\343\314X\240-\327\344\265\004i\203!\220\360o \021\354\201g\234\b\246\362\023\345\256\317WQ^\346\371/Su\365\t-^\272\207\b\234\341[x|\304>\r\rfai\301\t\255*\244W\321\371\365\034\301\\g\200\327*E|\025l\272\206\031\316/\221\234\350J\t\356<\201\332\362\020EtE\232G_Q\345D\273\301\001\221\262\267n\200\340\2522\371\033\027(d\361\206\230\343\021\212F\323\304\215\216\351Z\211~z\346F\025\341\342\331\341v\321\000R\270,`\n\357\032J\327\212\205\334K\357\242\300\305\r\221i\227\270\340\213\371\3207!$\223\025\306O(\314\242\016\200\242\273\312.\3564\341\211q3\002\216D\231*\325\261{t\310\004h\020\226=\361\025\n\206|a\001\301\004\377d\323\241\304`\221\237[&q\374\307\255\232\f}\260\250\021#t\001\021wT\201 \v\242zg\210\356k\323\2723\244\210!\355\231\230#\254|\n\236YS&\341\002x\347C\263\321\300\027lv\360!\f@\023\237\355^\267\215;\266\033y\267v:\017\224\341\bK7\034fN\023U~\2335w\354v\312\221\371\206\022\241\267:4\236f\261\r\250\273h\022\211\371\327\362\266\317\352\212OtFmVtuqg\265\271\005\247E%\356\031Aq\veZbg\202\r\373\301\335\005y\005\271\250\'\355\271\004\264}/\216\360\277\a\353: ;>\324A\"f\367\242\003\213\247\210\272*\262\201\2646\376\376\342\230\272\271\321!\266\265]\324\242\340\356\243\310\347Q\216\214\214\035XW]\304w\356\355{\220\275\261a\371(m\317\v7\354\304\r6\353\017\323\027yd\024\351V\373\233u\207\bX\t\232\2212\336\244Y8j\262\017>{HZ\342\352\313!J<\215\310U\221\256j|M\265\3034*\254o\237\r\b(\352\313\355q\034\376Ix\\1\324\036\271\273\f\245?\247\275T\245\213\225x\261\353\020j\223\213\317\b9\275\304\275s\000\233~3\224\353\250\306\035\211\337\323iJ/\372\'f\222\264\302\017\026\214\225u\t\2469`\313+D\254/<\030YCK\207\376u\3667\217\t4Z\200\245\2702\266e\230vh,Jm\370Le\305\327\\C\356\3568OZ1:F#\203\250\030]\026\255q|\261#\305M\001\241\3536M\237\321\247y\1773$!<\2571\332\343\314s\223\fT\356\366\206\274\332m\264\276\bF\202X\215\3045\001$A\362\t\033\317\314i\273\001`E\260\253\264n\376\332\337<\020\001s\000\235\266\232\335O,\275\322:\326\b\212D\301$\374~]U\305\003\002kt\266\205\tu\020S\177\006f\002A\266\025\377\271\r\3438\250<\3077,\237\3431\260,\226(\023\243v\245\031\3277\004\371\312\232\241\220\n\263\340\261\211\226\3343n2\030\360 \302t F\276$=\261C\315\021\352\200\257\264h\361\343\v]\005\303\317g\262\242\373J\246\205\206y\035!\233\261\222\005\246/\"\005\a\333KkS\215\267\033A\302u\240\023.\30