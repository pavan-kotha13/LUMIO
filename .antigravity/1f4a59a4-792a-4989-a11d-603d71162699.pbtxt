            }
            lines {
              text: "    const fullName = personalInfo.fullName || \'Candidate\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetRole = personalInfo.targetRole || personalInfo.currentTitleOrStatus || \'Software Engineer\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetIndustry = personalInfo.targetIndustry || \'Technology\';"
