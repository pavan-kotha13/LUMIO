      create_file {
        instruction: "import React from \'react\';\nimport { Check, X } from \'lucide-react\';\n\nexport const ComparisonProof: React.FC = () => {\n  const comparisonRows = [\n    {\n      dimension: \'Core Philosophy\',\n      generic: \'Stuff keywords to fool the ATS robot into scoring high\',\n      architect: \'Deconstruct executive mandate and prove past execution capability\',\n    },\n    {\n      dimension: \'Recruiter Reaction (6-sec scan)\',\n      generic: \'Skeptical glance: \"Everyone claims they did microservices and leadership\"\',\n      architect: \'Immediate pause: \"This person solved the exact problem we have right now\"\',\n    },\n    {\n      dimension: \'Evidence Standard\',\n      generic: \'Passive claims: \"Responsible for managing team and metrics\"\',\n      architect: \'Quantified vectors: Exact scale, architectural decisions, and delta results\',\n    },\n    {\n      dimension: \'ATS Compatibility\',\n      generic: \'Dense blocks of stuffed buzzwords that degrade visual layout\',\n      architect: \'Clean semantic structure with native parsing and clean typography\',\n    },\n    {\n      dimension: \'Interview Trajectory\',\n      generic: \'Grilling on technical fundamentals to verify if you really know what you claimed\',\n      architect: \'Collaborative strategy conversation treating you as a peer and solution owner\',\n    },\n  ];\n\n  return (\n    <section id=\"comparison\" className=\"py-16 md:py-24 border-t border-[#E5E1D7] scroll-mt-16\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"max-w-3xl mb-12\">\n          <p className=\"text-xs font-semibold tracking-wider uppercase text-[#1B4332] mb-2\">\n            The Fundamental Shift\n          </p>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#1C201D] [text-wrap:balance]\">\n            Why keyword-matched resumes get rejected\n          </h2>\n          <p className=\"mt-4 text-base text-[#57605A] leading-relaxed\">\n            Every candidate uses LLMs to mirror job posts word-for-word. Recruiter inboxes are\n            overflowing with identical clones. Here is how evidence architecture changes your odds.\n          </p>\n        </div>\n\n        {/* Comparison Table / Grid */}\n        <div className=\"bg-white rounded-2xl border border-[#E5E1D7] shadow-card overflow-hidden\">\n          <div className=\"grid grid-cols-1 md:grid-cols-12 border-b border-[#E5E1D7] bg-[#FAF8F5] text-xs font-semibold tracking-wider uppercase\">\n            <div className=\"md:col-span-4 p-4 text-[#848E88]\">Dimension</div>\n            <div className=\"md:col-span-4 p-4 text-[#8C2E2E] border-t md:border-t-0 md:border-l border-[#E5E1D7] flex items-center gap-1.5\">\n              <X className=\"w-3.5 h-3.5\" />\n              Generic AI Resume Tailoring\n            </div>\n            <div className=\"md:col-span-4 p-4 text-[#1B4332] border-t md:border-t-0 md:border-l border-[#E5E1D7] flex items-center gap-1.5 bg-[#F2F7F4]\">\n              <Check className=\"w-3.5 h-3.5\" />\n              Resume Architect Evidence Method\n            </div>\n          </div>\n\n          <div className=\"divide-y divide-[#E5E1D7]\">\n            {comparisonRows.map((row, idx) => (\n              <div\n                key={idx}\n                className=\"grid grid-cols-1 md:grid-cols-12 text-sm hover:bg-[#FAF8F5]/60 transition-colors\"\n              >\n                <div className=\"md:col-span-4 p-4 font-semibold text-[#1C201D] bg-[#FCFBF9] md:bg-transparent\">\n                  {row.dimension}\n                </div>\n                <div className=\"md:col-span-4 p-4 text-[#57605A] border-t md:border-t-0 md:border-l border-[#E5E1D7]\">\n                  {row.generic}\n                </div>\n                <div className=\"md:col-span-4 p-4 text-[#1C201D] font-medium border-t md:border-t-0 md:border-l border-[#E5E1D7] bg-[#F9FBFA]\">\n                  {row.architect}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
