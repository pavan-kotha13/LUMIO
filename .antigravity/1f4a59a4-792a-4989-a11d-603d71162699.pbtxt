      id: "call_948382"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { Button } from \'../common/Button\';\\nimport { ArrowRight, ShieldCheck, CheckCircle2, Sparkles, FileText } from \'lucide-react\';\\n\\ninterface HeroProps {\\n  onExploreDemo: () => void;\\n}\\n\\nexport const Hero: React.FC<HeroProps> = ({ onExploreDemo }) => {\\n  return (\\n    <section className=\\\"relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"text-center max-w-3xl mx-auto space-y-6\\\">\\n          {/* Tagline kicker */}\\n          <div className=\\\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EBF2EC] text-[#1B4332] text-xs font-semibold tracking-wide uppercase\\\">\\n            <ShieldCheck className=\\\"w-3.5 h-3.5 text-[#1B4332]\\\" />\\n            <span>The Career Evidence Engine</span>\\n          </div>\\n\\n          {/* Marquee Headline */}\\n          <h1 className=\\\"text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1C201D] leading-[1.12] [text-wrap:balance]\\\">\\n            Don\'t just match the job.{\' \'}\\n            <span className=\\\"text-[#1B4332] underline decoration-[#1B4332]/30 underline-offset-8\\\">\\n              Prove your fit.\\n            </span>\\n          </h1>\\n\\n          {/* Value proposition subhead */}\\n          <p className=\\\"text-base sm:text-lg text-[#57605A] leading-relaxed max-w-2xl mx-auto [text-wrap:balance]\\\">\\n            Generic AI writers spam resumes with shallow keywords that fail the 6-second recruiter\\n            test. Resume Architect reconstructs your career trajectory into rigorous, evidence-backed\\n            proof arguments that prove you can deliver on the mandate.\\n          </p>\\n\\n          {/* CTA Group */}\\n          <div className=\\\"pt-2 flex flex-col sm:flex-row items-center justify-center gap-3\\\">\\n            <Link to=\\\"/signup\\\" className=\\\"w-full sm:w-auto\\\">\\n              <Button\\n                size=\\\"lg\\\"\\n                variant=\\\"primary\\\"\\n                className=\\\"w-full sm:w-auto text-base\\\"\\n                rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n              >\\n                Start Architecting Free\\n              </Button>\\n            </Link>\\n            <Button\\n              size=\\\"lg\\\"\\n              variant=\\\"secondary\\\"\\n              className=\\\"w-full sm:w-auto text-base\\\"\\n              onClick={onExploreDemo}\\n              leftIcon={<FileText className=\\\"w-4 h-4 text-[#57605A]\\\" />}\\n            >\\n              Examine Live Proof Matrix\\n            </Button>\\n          </div>\\n\\n          {/* Social validation ribbon - clean unboxed typography */}\\n          <div className=\\\"pt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[#57605A]\\\">\\n            <span className=\\\"flex items-center gap-1.5 font-medium text-[#1C201D]\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5 text-[#1B4332]\\\" />\\n              No Keyword Stuffing\\n            </span>\\n            <span aria-hidden=\\\"true\\\" className=\\\"text-[#D6D1C4]\\\">\302\267</span>\\n            <span className=\\\"flex items-center gap-1.5 font-medium text-[#1C201D]\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5 text-[#1B4332]\\\" />\\n              FastAPI & Gemini Ready\\n            </span>\\n            <span aria-hidden=\\\"true\\\" className=\\\"text-[#D6D1C4]\\\">\302\267</span>\\n            <span className=\\\"flex items-center gap-1.5 font-medium text-[#1C201D]\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5 text-[#1B4332]\\\" />\\n              Executive Recruiter Calibrated\\n            </span>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Create Hero component with strong typographic presence and clear CTAs\", \"Overwrite\":true, \"TargetFile\":\"/src/components/landing/Hero.tsx\", \"toolAction\":\"Writing components/landing/Hero.tsx\", \"toolSummary\":\"Create Landing Hero component\"}"
