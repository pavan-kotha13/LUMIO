      thinking_signature: "\022\367\021\n\364\021\001i\024}\023\234A\250\375\263\272\222\263\305\242\367-\3348I\333\n`Q\355c\215\275\024\341\272}\262a\337_\224\317\271\353\211\360\263\370t\033\243\006(\315\210\343\216\004\327\300\254\222\262\305r\232b\332&G\350\376\257\365\327\307\2369\232\333\034(\310W\330%-\244\3173\370]U\272$\026\v\362-\201#\366\352z\304H\236\254\025\326\207\245`\371PR[\270\362\236F3\216JN\332v\221\203\222\321\255\026=s\321\343;\212~\276\344\251\206a]\350\244\367t\333\310\237f\335\255\031R\235\300b\002\246\270\250\304M\250\332\222z\fz\323\270\252\360j\271a\207q\262`\2117\214\220\023\032\263\273\366\241\302\364o\303\347z\233\246\312\213\350\317Y\3245;(\232\030u(\372r\026\330\314I/\310\231\033i\223\035\020<8\246\375\244\375\37443\212\177^\316\346\006l\306%\023M\"U\202v\0054\032n\320!\025\227h\330\247\000\ve\206z\004w*xI\236k\335\313\237Y>\324~\365\260\375\220z\364\203\250\331\022\021\307\204\320G\234\240\323\325\373\353\3042\207\272\233\000\370\230w\370\275\224\\\310%r(3\022\n\314V\2207s\206\v\251*A\237\3120\234|b\333\2474\321%\366\320\264!\211\274\340!\325\351Q\362\325\030:\214\304\205\343\261\225\234\"\226\\Ll\363\266\224\240\nS\036\357y]\340I\032q\313\206\251\037\035r\276\177\371\036\226\026\351\241\335&\232S\2179+\257$\003\332\324=\322B\247\253\241L\205\253u\361&\313\223\243Y66%\332\346\025X+<A\002T\224\300aj\233\356\353\351\243\351\206V\213\274\242v\206b\373\320?\334-|\266]\232Z\001\333\033\226\005\273<2o\351%\370*\247\005\377k\222n\020\033|\375\237\3457\207\307\205\211\311Ztg\325\230c3H\f7\001\373KA\277\207\017\263\a\314\304\310L^\017\372\275sWK\351\2154\001^\201\371\037\n\345\325\212}\020A\246[\347!g\225\340\356go`\306\350dA\026\311%f\350\227\326\3549\375\273\330V\337\200\366\271\335\\\306o\237&\372\204O\216\2206\221\325\\\210m\330).)\340\356%\207\247\275\362\215\300\232\200\270\a\\\341\356d\242\257X\017\311?\301\257\n\3122\367\005\217_\342\236\272\227%\233\37486\364\241\t\304_\212\332/Ue\320u\336\3539\242{\243\177>\026\277\223\351\364\324\3