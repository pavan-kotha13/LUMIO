  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Compass, Database, FileCheck, ArrowUpRight } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\nimport { Button } from \'../common/Button\';\n\nexport const ArchitectureProtocol: React.FC = () => {\n  const steps = [\n    {\n      step: \'01\',\n      title: \'Mandate Deconstruction\',\n      category: \'Stage 1 \302\267 Strategic Intent\',\n      description:\n        \'Job listings are defensive wish lists. We deconstruct the implicit problems behind the post\342\200\224scaling bottlenecks, migration debt, or revenue ceilings\342\200\224so your application addresses what leadership actually cares about.\',\n      points: [\n        \'Implicit pain point mapping\',\n        \'Seniority expectations calibration\',\n        \'Executive decision-maker alignment\',\n      ],\n      icon: Compass,\n    },\n    {\n      step: \'02\',\n      title: \'Impact Excavation\',\n      category: \'Stage 2 \302\267 Evidence Extraction\',\n      description:\n        \'Instead of hallucinating fake bullet points, our interview protocol excavates your genuine achievements. We extract the scope, architectural decisions, and verifiable business deltas you actually delivered.\',\n      points: [\n        \'Scale & complexity isolation\',\n        \'Technical ownership documentation\',\n        \'Defensible quantitative validation\',\n      ],\n      icon: Database,\n    },\n    {\n      step: \'03\',\n      title: \'Precision Dossier Generation\',\n      category: \'Stage 3 \302\267 Document Synthesis\',\n      description:\n        \'Your tailored dossier is compiled with typographic hierarchy and zero fluff. Every bullet point is an ironclad proof argument that survives ATS filters and commands immediate respect during the 6-second recruiter review.\',\n      points: [\n        \'ATS-pristine semantic structure\',\n        \'Executive-grade typography scale\',\n        \'Interview talk-track synchronization\',\n      ],\n      icon: FileCheck,\n    },\n  ];\n\n  return (\n    <section id=\"methodology\" className=\"py-16 md:py-24 border-t border-[#E5E1D7] scroll-mt-16\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"max-w-3xl mb-14\">\n          <p className=\"text-xs font-semibold tracking-wider uppercase text-[#1B4332] mb-2\">\n            The Three-Stage Architecture Protocol\n          </p>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#1C201D] [text-wrap:balance]\">\n            How we transform career history into undeniable proof\n          </h2>\n          <p className=\"mt-4 text-base text-[#57605A] leading-relaxed\">\n            A resume should not read like a passive job description diary. It must read like an\n            executive evidence dossier prepared for a hiring committee.\n          </p>\n        </div>\n\n        {/* 3 Step Editorial Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {steps.map((item) => {\n            const Icon = item.icon;\n            return (\n              <div\n                key={item.step}\n                className=\"bg-white rounded-2xl border border-[#E5E1D7] p-8 shadow-card flex flex-col justify-between hover:border-[#D6D1C4] transition-all\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-6\">\n                    <span className=\"text-3xl font-bold text-[#1B4332] tracking-tight font-mono\">\n                      {item.step}\n                    </span>\n                    <div className=\"w-10 h-10 rounded-xl bg-[#FAF8F5] border border-[#E5E1D7] flex items-center justify-center text-[#1B4332]\">\n                      <Icon className=\"w-5 h-5\" />\n                    </div>\n                  </div>\n\n                  <span className=\"text-xs font-semibold tracking-wider uppercase text-[#848E88] block mb-1\">\n                    {item.category}\n                  </span>\n                  <h3 className=\"text-xl font-bold text-[#1C201D] mb-3\">{item.title}</h3>\n                  <p className=\"text-sm text-[#57605A] leading-relaxed mb-6\">{item.description}</p>\n                </div>\n\n                <div className=\"pt-6 border-t border-[#F0ECE1]\">\n                  <ul className=\"space-y-2 text-xs text-[#1C201D]\">\n                    {item.points.map((pt, i) => (\n                      <li key={i} className=\"flex items-center gap-2\">\n                        <span className=\"w-1.5 h-1.5 rounded-full bg-[#1B4332]\" />\n                        <span>{pt}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Quote banner */}\n        <div className=\"mt-14 p-8 rounded-2xl bg-[#F3EFE7] border border-[#E5E1D7] flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-1\">\n            <p className=\"text-base font-semibold text-[#1C201D]\">\n              \"Hiring managers don\'t ask \'did they use our tools?\' They ask \'can they solve our problems at our scale?\'\"\n            </p>\n            <p className=\"text-xs text-[#57605A]\">\n              Elena Rostova \302\267 Former VP of Engineering at Cloudflare & Senior Technical Advisor\n            </p>\n          </div>\n          <Link to=\"/signup\" className=\"shrink-0\">\n            <Button variant=\"primary\" size=\"md\" rightIcon={<ArrowUpRight className=\"w-4 h-4\" />}>\n              Build Your Proof Docket\n            </Button>\n          </Link>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/landing/ArchitectureProtocol.tsx"
        }
        overwrite: true
      }
    }
