      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Sidebar, DashboardTab } from \'../components/dashboard/Sidebar\';\\nimport { DashboardHeader } from \'../components/dashboard/DashboardHeader\';\\n\\ninterface DashboardLayoutProps {\\n  currentTab: DashboardTab;\\n  onSelectTab: (tab: DashboardTab) => void;\\n  onCreateClick: () => void;\\n  onReviewClick: () => void;\\n  resumeCount?: number;\\n  children: React.ReactNode;\\n}\\n\\nexport const DashboardLayout: React.FC<DashboardLayoutProps> = ({\\n  currentTab,\\n  onSelectTab,\\n  onCreateClick,\\n  onReviewClick,\\n  resumeCount = 3,\\n  children,\\n}) => {\\n  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF8F5] flex selection:bg-[#1B4332] selection:text-white\\\">\\n      {/* Persistent Left Sidebar (Desktop: 256px wide fixed; Mobile: sliding drawer) */}\\n      <Sidebar\\n        currentTab={currentTab}\\n        onSelectTab={onSelectTab}\\n        mobileOpen={mobileSidebarOpen}\\n        onCloseMobile={() => setMobileSidebarOpen(false)}\\n        resumeCount={resumeCount}\\n      />\\n\\n      {/* Main Content Area (Offset by 256px on lg screens) */}\\n      <div className=\\\"flex-1 lg:pl-64 flex flex-col min-h-screen\\\">\\n        <DashboardHeader\\n          currentTab={currentTab}\\n          onOpenMobileSidebar={() => setMobileSidebarOpen(true)}\\n          onCreateClick={onCreateClick}\\n          onReviewClick={onReviewClick}\\n        />\\n\\n        <main className=\\\"flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto\\\">\\n          {children}\\n        </main>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DashboardLayout with fixed 256px left sidebar and responsive header/content area\", \"Overwrite\":true, \"TargetFile\":\"/src/layouts/DashboardLayout.tsx\", \"toolAction\":\"Writing layouts/DashboardLayout.tsx\", \"toolSummary\":\"Create DashboardLayout component\"}"
