            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 1. Transparent Rule-Based Metric Computations for 7 dimensions"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const headlineLen = (headline || \'\').trim().length;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let headlineScore = 40;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (headlineLen >= 40 && headlineLen <= 220) headlineScore += 35;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    else if (headlineLen > 0) headlineScore += 15;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (headline.includes(\'|\') || headline.includes(\'\342\200\242\') || headline.includes(\'\342\200\224\') || headline.includes(\'/\')) headlineScore += 15;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const hasRoleInHeadline = targetRole && headline.toLowerCase().includes(targetRole.toLowerCase().split(\' \')[0]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (hasRoleInHeadline) headlineScore += 10;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
