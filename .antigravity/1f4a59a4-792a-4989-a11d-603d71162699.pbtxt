              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    else if (allSkillsCount >= 1) skillsScore = 60;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
