  code_action {
    action_spec {
      create_file {
        instruction: "import os\nimport json\nimport requests\nfrom typing import Dict, List, Any, Optional\nfrom backend.app.core.config import GEMINI_API_KEY, GEMINI_MODEL\n\nSYSTEM_INSTRUCTION = (\n    \"You are an expert ATS Resume Architect and Career Engineering Engine. \"\n    \"CRITICAL CONSTRAINTS: \"\n    \"1. You must strictly use ONLY the user\'s provided verified facts, skills, background, and achievements. \"\n    \"2. NEVER invent, hallucinate, or add unmentioned companies, degrees, dates, tools, projects, or statistics. \"\n    \"3. Organize information cleanly, improve sentence clarity, use strong active verbs (STAR/XYZ format), and structure for ATS readability. \"\n    \"4. Return clean, unadorned valid JSON when structured output is requested.\"\n)\n\ndef call_gemini(prompt: str, system_instruction: str = SYSTEM_INSTRUCTION) -> Optional[str]:\n    \"\"\"Calls Gemini API using standard REST endpoint.\"\"\"\n    if not GEMINI_API_KEY:\n        return None\n\n    url = f\"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent?key={GEMINI_API_KEY}\"\n    payload = {\n        \"contents\": [\n            {\n                \"parts\": [\n                    {\"text\": prompt}\n                ]\n            }\n        ],\n        \"systemInstruction\": {\n            \"parts\": [\n                {\"text\": system_instruction}\n            ]\n        },\n        \"generationConfig\": {\n            \"temperature\": 0.2,\n            \"maxOutputTokens\": 4096,\n        }\n    }\n\n    try:\n        response = requests.post(url, json=payload, headers={\"Content-Type\": \"application/json\"}, timeout=30)\n        if response.status_code == 200:\n            data = response.json()\n            candidates = data.get(\"candidates\", [])\n            if candidates:\n                parts = candidates[0].get(\"content\", {}).get(\"parts\", [])\n                if parts:\n                    return parts[0].get(\"text\", \"\").strip()\n        else:\n            print(f\"Gemini API returned status {response.status_code}: {response.text[:200]}\")\n    except Exception as e:\n        print(f\"Error calling Gemini API: {e}\")\n\n    return None\n\ndef clean_json_text(text: str) -> str:\n    \"\"\"Strip markdown code fence if present.\"\"\"\n    if not text:\n        return \"{}\"\n    text = text.strip()\n    if text.startswith(\"```\"):\n        text = text.split(\"\\n\", 1)[1] if \"\\n\" in text else text[3:]\n    if text.endswith(\"```\"):\n        text = text.rsplit(\"```\", 1)[0]\n    return text.strip()\n\n# Operation A: Create Resume Support\ndef generate_professional_summary(\n    target_role: str,\n    target_industry: str,\n    experience_notes: str,\n    skills: List[str]\n) -> str:\n    prompt = f\"\"\"Candidate Information:\nTarget Role: {target_role or \'Professional\'}\nTarget Industry: {target_industry or \'Technology\'}\nSkills: {\', \'.join(skills) if skills else \'Not specified\'}\nExperience Notes: {experience_notes or \'Not specified\'}\n\nTask: Generate a concise, 3-sentence professional resume summary.\nConstraint: Use ONLY the provided information. Do not fabricate metrics or unmentioned companies.\"\"\"\n\n    text = call_gemini(prompt)\n    if text:\n        return text\n\n    # Deterministic fallback\n    top_skills = \', \'.join(skills[:4]) if skills else \"engineering problem-solving\"\n    return f\"Results-driven {target_role or \'Engineer\'} with hands-on technical proficiency in {top_skills}. Proven track record delivering maintainable, high-impact solutions in fast-paced collaborative environments.\"\n\ndef rewrite_bullets(raw_bullets: str, role_title: str, company: str) -> List[str]:\n    prompt = f\"\"\"Role: {role_title} at {company}\nRaw Responsibilities / Draft Notes:\n{raw_bullets}\n\nTask: Rewrite each point into clear, ATS-conscious bullet points starting with strong action verbs.\nConstraint: Retain factual accuracy. Do not invent metrics or technologies not present in the draft.\nFormat: Return one bullet point per line.\"\"\"\n\n    text = call_gemini(prompt)\n    if text:\n        lines = [l.lstrip(\"\342\200\242-*0123456789. \").strip() for l in text.split(\"\\n\") if l.strip()]\n        return lines\n\n    # Fallback\n    return [f\"Engineered and executed {b.strip().lstrip(\'\342\200\242-* \')}\" for b in raw_bullets.split(\"\\n\") if b.strip()]\n\ndef recommend_skills(target_role: str, current_skills: List[str]) -> List[str]:\n    prompt = f\"\"\"Target Role: {target_role}\nCurrent Skills: {\', \'.join(current_skills)}\n\nTask: Suggest 6 to 8 standard industry keywords and tools for this role that the candidate should consider adding if they possess them.\nReturn ONLY a comma-separated list of skill names.\"\"\"\n\n    text = call_gemini(prompt)\n    if text:\n        items = [s.strip() for s in text.split(\",\") if s.strip() and s.strip().lower() not in [c.lower() for c in current_skills]]\n        return items[:8]\n\n    # Standard fallback\n    defaults = [\"REST APIs\", \"Unit Testing\", \"System Architecture\", \"Git Version Control\", \"CI/CD Pipelines\", \"Docker\"]\n    return [d for d in defaults if d.lower() not in [c.lower() for c in current_skills]]\n\n# Operation C: Improve Resume\ndef improve_resume_content(resume_data: Dict[str, Any], job_description: str) -> Dict[str, Any]:\n    prompt = f\"\"\"Job Description:\n{job_description[:3000]}\n\nCurrent Resume JSON:\n{json.dumps(resume_data, indent=2)[:3000]}\n\nTask: Improve the resume content to align with the job description while strictly obeying TruthGuard zero-hallucination constraints:\n1. Rephrase summary to highlight alignment with job requirements using existing candidate credentials.\n2. Polish experience bullets to emphasize relevant action verbs and outcomes.\n3. Suggest genuine keywords that directly match the candidate\'s existing experience.\n4. DO NOT invent unmentioned qualifications or statistics.\n\nReturn ONLY a valid JSON object matching this structure:\n{{\n  \"improvedSummary\": \"<improved summary text>\",\n  \"improvedExperience\": [\n    {{\n      \"role\": \"<role>\",\n      \"company\": \"<company>\",\n      \"bullets\": [\"<improved bullet 1>\", \"<improved bullet 2>\"]\n    }}\n  ],\n  \"recommendedKeywords\": [\"<kw1>\", \"<kw2>\"]\n}}\"\"\"\n\n    text = call_gemini(prompt)\n    if text:\n        try:\n            return json.loads(clean_json_text(text))\n        except Exception:\n            pass\n\n    return {\n        \"improvedSummary\": resume_data.get(\"summary\", \"\"),\n        \"improvedExperience\": resume_data.get(\"experience\", []),\n        \"recommendedKeywords\": [\"Scalability\", \"Clean Code\", \"Design Patterns\", \"Agile Development\"]\n    }\n"
        path {
          absolute_uri: "file:///backend/app/services/gemini_service.py"
        }
        overwrite: true
      }
    }
