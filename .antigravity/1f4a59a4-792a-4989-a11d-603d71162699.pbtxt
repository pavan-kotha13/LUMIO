\\b\', line, re.I):\n            flags.append({\n                \"claim\": line[:100] + (\"...\" if len(line) > 100 else \"\"),\n                \"status\": \"SUPPORTED\",\n                \"reason\": \"Direct active verb demonstrating individual engineering responsibility.\",\n                \"recommendation\": \"Approved for inclusion in final ATS resume.\"\n            })\n\n    # Return top 5-7 meaningful flags\n    return flags[:7]\n"
