      create_file {
        instruction: "import React from \'react\';\nimport { Check, ArrowRight } from \'lucide-react\';\nimport { Button } from \'../common/Button\';\nimport { Link } from \'react-router-dom\';\n\nexport const PricingSection: React.FC = () => {\n  const plans = [\n    {\n      id: \'active-search\',\n      name: \'Candidate Edition\',\n      tagline: \'For active job seekers targeting mid-to-senior technical & product roles.\',\n      price: \'$29\',\n      period: \'per month\',\n      features: [\n        \'Up to 10 Tailored Resume Architect Blueprints / mo\',\n        \'Mandate Deconstruction for posted job specs\',\n        \'Quantified Evidence bullet generator\',\n        \'ATS Semantic PDF & DocX export\',\n        \'FastAPI & Gemini AI tailoring pipeline\',\n      ],\n      popular: false,\n      ctaLabel: \'Start Candidate Plan\',\n    },\n    {\n      id: \'executive\',\n      name: \'Executive Fellowship\',\n      tagline: \'For Staff, Principal, Director, and VP leaders proving high-stakes impact.\',\n      price: \'$69\',\n      period: \'per month\',\n      features: [\n        \'Unlimited Architect Tailored Blueprints\',\n        \'Executive Mandate & Hiring Committee calibration\',\n        \'Deep Evidence Docket (Scale, Revenue, Governance)\',\n        \'Strategic Cover Letters with proof matrices\',\n        \'LinkedIn Profile & Narrative realignment\',\n        \'Priority access to future Python backend updates\',\n      ],\n      popular: true,\n      ctaLabel: \'Join Executive Fellowship\',\n    },\n    {\n      id: \'career-advisory\',\n      name: \'Lifetime Architect\',\n      tagline: \'Permanent access to our ongoing career engineering & dossier architecture.\',\n      price: \'$249\',\n      period: \'one-time purchase\',\n      features: [\n        \'Lifetime access to all future core updates\',\n        \'Full portfolio structuring for board & advisory roles\',\n        \'Custom template typography & layout customization\',\n        \'Direct email support with former executive recruiters\',\n        \'Continuous Gemini model upgrades & exports\',\n      ],\n      popular: false,\n      ctaLabel: \'Acquire Lifetime License\',\n    },\n  ];\n\n  return (\n    <section id=\"pricing\" className=\"py-16 md:py-24 border-t border-[#E5E1D7] scroll-mt-16\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"max-w-3xl mb-14 text-center mx-auto\">\n          <p className=\"text-xs font-semibold tracking-wider uppercase text-[#1B4332] mb-2\">\n            Transparent Investment\n          </p>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#1C201D] [text-wrap:balance]\">\n            Invest in proof. Settle for nothing less than fair market value.\n          </h2>\n          <p className=\"mt-4 text-base text-[#57605A] leading-relaxed max-w-xl mx-auto\">\n            A single higher-tier offer from substantiated proof typically pays for a decade of Resume Architect.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch\">\n          {plans.map((p) => (\n            <div\n              key={p.id}\n              className={`rounded-2xl p-8 flex flex-col justify-between transition-all relative ${\n                p.popular\n                  ? \'bg-white border-2 border-[#1B4332] shadow-elevated\'\n                  : \'bg-white border border-[#E5E1D7] shadow-card hover:border-[#D6D1C4]\'\n              }`}\n            >\n              {p.popular && (\n                <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-[#1B4332] text-white text-[11px] font-semibold tracking-wider uppercase px-3 py-0.5 rounded-full shadow-sm\">\n                  Recommended for Senior Talent\n                </div>\n              )}\n\n              <div>\n                <h3 className=\"text-lg font-bold text-[#1C201D]\">{p.name}</h3>\n                <p className=\"text-xs text-[#57605A] mt-1 min-h-[36px]\">{p.tagline}</p>\n\n                <div className=\"mt-6 mb-8 flex items-baseline gap-1.5\">\n                  <span className=\"text-4xl font-bold tracking-tight text-[#1C201D] tabular-nums font-mono\">\n                    {p.price}\n                  </span>\n                  <span className=\"text-xs text-[#57605A]\">/{p.period}</span>\n                </div>\n\n                <div className=\"space-y-3 pt-6 border-t border-[#F0ECE1]\">\n                  <span className=\"text-xs font-semibold text-[#1C201D] block\">Includes:</span>\n                  <ul className=\"space-y-2.5 text-xs text-[#57605A]\">\n                    {p.features.map((f, i) => (\n                      <li key={i} className=\"flex items-start gap-2.5\">\n                        <Check className=\"w-4 h-4 text-[#1B4332] shrink-0 mt-0.5\" />\n                        <span>{f}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n\n              <div className=\"pt-8 mt-8 border-t border-[#F0ECE1]\">\n                <Link to=\"/signup\" className=\"block w-full\">\n                  <Button\n                    variant={p.popular ? \'primary\' : \'secondary\'}\n                    size=\"md\"\n                    className=\"w-full\"\n                    rightIcon={<ArrowRight className=\"w-3.5 h-3.5\" />}\n                  >\n                    {p.ctaLabel}\n                  </Button>\n                </Link>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
