            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "## 3. Python FastAPI Integration Blueprint"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "The frontend is already configured with an API client in `src/services/api.ts` pointing to `VITE_API_URL` (defaulting to `/api/v1`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### Recommended FastAPI Endpoints:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "1. **Authentication** (`/api/v1/auth`):"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - `POST /login`: Accepts `{\"email\", \"password\"}` -> Returns `{\"access_token\", \"token_type\": \"bearer\", \"user\": {...}}`"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - `POST /register`: Accepts `{\"name\", \"email\", \"password\", \"target_role\", \"seniority\"}` -> Returns user session"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "2. **Job Mandate Parsing** (`/api/v1/mandates`):"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - `POST /deconstruct`: Parses raw job description into explicit and implicit hiring requirements."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "3. **Gemini AI Evidence Tailoring** (`/api/v1/resumes`):"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - `POST /architect-proof`: Pairs candidate work history with target mandate to generate quantified evidence bullets."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "* **Canvas Background**: Warm off-white / cream (`#FAF8F5`, `#FCFBF8`, `#F3EFE7`)"
