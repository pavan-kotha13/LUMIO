        instruction: "import React from \'react\';\nimport { Logo } from \'./Logo\';\nimport { Link } from \'react-router-dom\';\n\nexport const Footer: React.FC = () => {\n  return (\n    <footer className=\"border-t border-[#E5E1D7] bg-[#FAF8F5] text-[#57605A] text-sm mt-20\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-10\">\n          {/* Brand & Manifesto */}\n          <div className=\"md:col-span-1 space-y-4\">\n            <Logo />\n            <p className=\"text-xs text-[#57605A] leading-relaxed max-w-sm\">\n              Don\'t just match the job. Prove your fit. Resume Architect replaces keyword stuffing\n              with verifiable impact arguments that convince hiring leaders.\n            </p>\n            <div className=\"flex items-center gap-2 text-xs text-[#848E88]\">\n              <span>Executive Grade</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>FastAPI & AI Ready</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>v1.0</span>\n            </div>\n          </div>\n\n          {/* Product */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-[#1C201D]\">Product</h4>\n            <ul className=\"space-y-2 text-xs\">\n              <li>\n                <a href=\"#methodology\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Architect Protocol\n                </a>\n              </li>\n              <li>\n                <a href=\"#proof-engine\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Evidence Decomposition\n                </a>\n              </li>\n              <li>\n                <a href=\"#comparison\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Match vs. Prove Matrix\n                </a>\n              </li>\n              <li>\n                <a href=\"#pricing\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Pricing Plans\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Architecture Principles */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-[#1C201D]\">\n              Methodology\n            </h4>\n            <ul className=\"space-y-2 text-xs\">\n              <li>\n                <span className=\"text-[#57605A]\">Zero Keyword Stuffing</span>\n              </li>\n              <li>\n                <span className=\"text-[#57605A]\">Mandate Deconstruction</span>\n              </li>\n              <li>\n                <span className=\"text-[#57605A]\">Quantified Evidence Dockets</span>\n              </li>\n              <li>\n                <span className=\"text-[#57605A]\">Hiring Decision Matrix</span>\n              </li>\n            </ul>\n          </div>\n\n          {/* Account & Access */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-[#1C201D]\">Access</h4>\n            <ul className=\"space-y-2 text-xs\">\n              <li>\n                <Link to=\"/login\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Candidate Sign In\n                </Link>\n              </li>\n              <li>\n                <Link to=\"/signup\" className=\"hover:text-[#1C201D] transition-colors\">\n                  Create Workspace\n                </Link>\n              </li>\n              <li>\n                <span className=\"text-[#848E88]\">API Integration (FastAPI)</span>\n              </li>\n              <li>\n                <span className=\"text-[#848E88]\">Gemini AI Blueprint Engine</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div className=\"mt-12 pt-6 border-t border-[#E5E1D7] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#848E88]\">\n          <p>\302\251 {new Date().getFullYear()} Resume Architect. All rights reserved.</p>\n          <div className=\"flex items-center gap-4\">\n            <span className=\"hover:text-[#57605A] transition-colors cursor-pointer\">\n              Privacy Notice\n            </span>\n            <span>\302\267</span>\n            <span className=\"hover:text-[#57605A] transition-colors cursor-pointer\">\n              Terms of Service\n            </span>\n            <span>\302\267</span>\n            <span className=\"hover:text-[#57605A] transition-colors cursor-pointer\">\n              Security Standards\n            </span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
