  code_action {
    action_spec {
      create_file {
        instruction: "import re\nfrom typing import Dict, List, Any\nimport pymupdf\nimport docx\n\ndef extract_text_from_pdf(file_path: str) -> str:\n    \"\"\"Extract plain text from PDF using PyMuPDF.\"\"\"\n    text_parts = []\n    with pymupdf.open(file_path) as doc:\n        for page in doc:\n            text_parts.append(page.get_text())\n    return \"\\n\".join(text_parts).strip()\n\ndef extract_text_from_docx(file_path: str) -> str:\n    \"\"\"Extract plain text from DOCX using python-docx.\"\"\"\n    doc = docx.Document(file_path)\n    text_parts = [p.text for p in doc.paragraphs if p.text.strip()]\n    return \"\\n\".join(text_parts).strip()\n\ndef parse_resume_content(raw_text: str) -> Dict[str, Any]:\n    \"\"\"\n    Parses unstructured text into standard Resume Architect structured JSON.\n    \"\"\"\n    lines = [l.strip() for l in raw_text.split(\"\\n\") if l.strip()]\n\n    # Extract email and phone\n    email_match = re.search(r\'[\\w.-]+@[\\w.-]+\\.\\w+\', raw_text)\n    phone_match = re.search(r\'(\\+?\\d{1,3}[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\', raw_text)\n    linkedin_match = re.search(r\'linkedin\\.com/in/[\\w-]+\', raw_text, re.I)\n    github_match = re.search(r\'github\\.com/[\\w-]+\', raw_text, re.I)\n\n    name = lines[0] if lines else \"Candidate Name\"\n    if len(name.split()) > 4 or any(c in name for c in [\"@\", \"http\", \"resume\"]):\n        name = \"Candidate Name\"\n\n    contact_info = {\n        \"name\": name,\n        \"email\": email_match.group(0) if email_match else \"\",\n        \"phone\": phone_match.group(0) if phone_match else \"\",\n        \"location\": \"\",\n        \"linkedin\": f\"https://{linkedin_match.group(0)}\" if linkedin_match else \"\",\n        \"github\": f\"https://{github_match.group(0)}\" if github_match else \"\",\n        \"portfolio\": \"\"\n    }\n\n    # Extract common technical skills\n    common_skills = [\n        \"Python\", \"JavaScript\", \"TypeScript\", \"React\", \"Node.js\", \"Express\", \"FastAPI\",\n        \"SQL\", \"PostgreSQL\", \"MongoDB\", \"AWS\", \"Docker\", \"Kubernetes\", \"Git\", \"HTML\",\n        \"CSS\", \"Tailwind CSS\", \"REST APIs\", \"GraphQL\", \"CI/CD\", \"Linux\", \"Agile\", \"Scrum\"\n    ]\n    detected_skills = []\n    text_lower = raw_text.lower()\n    for s in common_skills:\n        if re.search(r\'\\b\' + re.escape(s.lower()) + r\'\\b\', text_lower):\n            detected_skills.append(s)\n\n    # Split into sections\n    sections: Dict[str, List[str]] = {\n        \"summary\": [],\n        \"experience\": [],\n        \"education\": [],\n        \"projects\": [],\n        \"skills\": []\n    }\n    \n    current_sec = \"summary\"\n    for line in lines[1:]:\n        l_low = line.lower()\n        if any(h in l_low for h in [\"experience\", \"work history\", \"employment\"]) and len(line) < 35:\n            current_sec = \"experience\"\n            continue\n        elif any(h in l_low for h in [\"education\", \"academic\", \"university\"]) and len(line) < 35:\n            current_sec = \"education\"\n            continue\n        elif any(h in l_low for h in [\"projects\", \"technical projects\"]) and len(line) < 35:\n            current_sec = \"projects\"\n            continue\n        elif any(h in l_low for h in [\"skills\", \"technologies\", \"proficiencies\"]) and len(line) < 35:\n            current_sec = \"skills\"\n            continue\n\n        sections[current_sec].append(line)\n\n    summary_text = \" \".join(sections[\"summary\"][:4]) if sections[\"summary\"] else \"\"\n\n    # Parse experience into roles\n    experience_items = []\n    current_role = None\n    for l in sections[\"experience\"]:\n        if re.search(r\'\\b(engineer|developer|manager|lead|architect|consultant|analyst|intern)\\b\', l, re.I) and len(l) < 60:\n            if current_role:\n                experience_items.append(current_role)\n            current_role = {\n                \"id\": str(len(experience_items) + 1),\n                \"role\": l,\n                \"company\": \"Company / Organization\",\n                \"location\": \"\",\n                \"startDate\": \"\",\n                \"endDate\": \"Present\",\n                \"current\": True,\n                \"bullets\": []\n            }\n        elif current_role:\n            if l.startswith(\"\342\200\242\") or l.startswith(\"-\") or l.startswith(\"*\") or len(l) > 20:\n                current_role[\"bullets\"].append(l.lstrip(\"\342\200\242-* \").strip())\n\n    if current_role:\n        experience_items.append(current_role)\n\n    if not experience_items and sections[\"experience\"]:\n        experience_items.append({\n            \"id\": \"1\",\n            \"role\": \"Software Engineer\",\n            \"company\": \"Professional Experience\",\n            \"location\": \"\",\n            \"startDate\": \"\",\n            \"endDate\": \"Present\",\n            \"current\": True,\n            \"bullets\": [b.lstrip(\"\342\200\242-* \").strip() for b in sections[\"experience\"] if len(b) > 20][:4]\n        })\n\n    # Education items\n    education_items = []\n    for l in sections[\"education\"]:\n        if any(w in l.lower() for w in [\"bachelor\", \"master\", \"b.tech\", \"degree\", \"university\", \"institute\", \"college\"]):\n            education_items.append({\n                \"id\": str(len(education_items) + 1),\n                \"degree\": l,\n                \"institution\": \"University / College\",\n                \"location\": \"\",\n                \"graduationYear\": re.search(r\'\\b(20\\d\\d)\\b\', l).group(1) if re.search(r\'\\b(20\\d\\d)\\b\', l) else \"\",\n                \"gpa\": \"\",\n                \"highlights\": \"\"\n            })\n\n    # Projects\n    projects_items = []\n    for l in sections[\"projects\"]:\n        if len(l) < 40 and not l.startswith(\"\342\200\242\"):\n            projects_items.append({\n                \"id\": str(len(projects_items) + 1),\n                \"title\": l,\n                \"technologies\": detected_skills[:4],\n                \"link\": \"\",\n                \"bullets\": []\n            })\n        elif projects_items and (l.startswith(\"\342\200\242\") or len(l) > 20):\n            projects_items[-1][\"bullets\"].append(l.lstrip(\"\342\200\242-* \").strip())\n\n    return {\n        \"contactInfo\": contact_info,\n        \"summary\": summary_text,\n        \"skills\": detected_skills or [\"Software Engineering\", \"Problem Solving\", \"Git\"],\n        \"experience\": experience_items,\n        \"education\": education_items,\n        \"projects\": projects_items,\n        \"certifications\": []\n    }\n"
        path {
          absolute_uri: "file:///backend/app/services/resume_parser.py"
        }
        overwrite: true
      }
    }
