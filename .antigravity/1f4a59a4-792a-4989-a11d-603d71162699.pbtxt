      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update handleRunEvaluation and add handleApplyRecommendation in ResumeReviewerView.tsx\", \"EndLine\":250, \"Instruction\":\"Store active candidate text, add recommendation apply logic, and open audit modal on export\", \"ReplacementContent\":\"    if (!candidateContent.trim()) {\\n      showToast(\'Please provide resume content before analyzing.\');\\n      return;\\n    }\\n\\n    if (!jobDescriptionText.trim()) {\\n      showToast(\'Please paste a job description or select a preset mandate.\');\\n      return;\\n    }\\n\\n    setActiveResumeText(candidateContent);\\n    setAppliedRecommendationIds([]);\\n    setIsEvaluating(true);\\n    setEvaluationStage(\'Parsing resume ATS semantic tokens...\');\\n\\n    const timer1 = setTimeout(() => {\\n      setEvaluationStage(\'Analyzing job description keyword density...\');\\n    }, 400);\\n\\n    const timer2 = setTimeout(() => {\\n      setEvaluationStage(\'Computing deterministic 6-pillar weighted scores...\');\\n    }, 800);\\n\\n    try {\\n      const result = await scoreEngineService.evaluateResume(\\n        candidateContent,\\n        jobDescriptionText,\\n        {\\n          targetRole: targetJobTitle,\\n          companyName: targetCompany,\\n          resumeFileName: fileName,\\n        }\\n      );\\n      setEvaluationResult(result);\\n      showToast(`Compatibility Score Calculated: ${result.overallScore} / 100 (${result.scoreGrade})`);\\n    } catch (err) {\\n      console.error(\'Analysis error:\', err);\\n      // Fallback to canonical benchmark\\n      setEvaluationResult(scoreEngineService.getBenchmarkEvaluation());\\n    } finally {\\n      clearTimeout(timer1);\\n      clearTimeout(timer2);\\n      setIsEvaluating(false);\\n      setEvaluationStage(\'\');\\n    }\\n  };\\n\\n  const handlePrintReport = () => {\\n    setIsAuditReportOpen(true);\\n  };\\n\\n  const handleApplyRecommendation = (rec: ImprovementRecommendation) => {\\n    if (appliedRecommendationIds.includes(rec.id)) return;\\n\\n    setAppliedRecommendationIds((prev) => [...prev, rec.id]);\\n\\n    if (evaluationResult) {\\n      const newScore = Math.min(99, evaluationResult.overallScore + rec.estimatedScoreDelta);\\n      const newGrade =\\n        newScore >= 90\\n          ? \'Exceptional\'\\n          : newScore >= 80\\n          ? \'Strong\'\\n          : newScore >= 70\\n          ? \'Competitive\'\\n          : \'Needs Revision\';\\n\\n      setEvaluationResult({\\n        ...evaluationResult,\\n        overallScore: newScore,\\n        scoreGrade: newGrade,\\n      });\\n\\n      showToast(`Applied rewrite: +${rec.estimatedScoreDelta} points added! Compatibility now ${newScore}/100.`);\\n    }\\n  };\\n\\n  const handleCopyKeyword = (kw: MissingKeyword) => {\\n    navigator.clipboard.writeText(kw.term);\\n    setCopiedKeywordId(kw.id);\\n    setTimeout(() => setCopiedKeywordId(null), 2000);\\n    showToast(`Copied keyword \\\"${kw.term}\\\" to clipboard.`);\\n  };\", \"StartLine\":198, \"TargetContent\":\"    if (!candidateContent.trim()) {\\n      showToast(\'Please provide resume content before analyzing.\');\\n      return;\\n    }\\n\\n    if (!jobDescriptionText.trim()) {\\n      showToast(\'Please paste a job description or select a preset mandate.\');\\n      return;\\n    }\\n\\n    setIsEvaluating(true);\\n    setEvaluationStage(\'Parsing resume ATS semantic tokens...\');\\n\\n    const timer1 = setTimeout(() => {\\n      setEvaluationStage(\'Analyzing job description keyword density...\');\\n    }, 400);\\n\\n    const timer2 = setTimeout(() => {\\n      setEvaluationStage(\'Computing deterministic 6-pillar weighted scores...\');\\n    }, 800);\\n\\n    try {\\n      const result = await scoreEngineService.evaluateResume(\\n        candidateContent,\\n        jobDescriptionText,\\n        {\\n          targetRole: targetJobTitle,\\n          companyName: targetCompany,\\n          resumeFileName: fileName,\\n        }\\n      );\\n      setEvaluationResult(result);\\n      showToast(`Compatibility Score Calculated: ${result.overallScore} / 100 (${result.scoreGrade})`);\\n    } catch (err) {\\n      console.error(\'Analysis error:\', err);\\n      // Fallback to canonical benchmark\\n      setEvaluationResult(scoreEngineService.getBenchmarkEvaluation());\\n    } finally {\\n      clearTimeout(timer1);\\n      clearTimeout(timer2);\\n      setIsEvaluating(false);\\n      setEvaluationStage(\'\');\\n    }\\n  };\\n\\n  const handlePrintReport = () => {\\n    window.print();\\n  };\\n\\n  const handleCopyKeyword = (kw: MissingKeyword) => {\\n    navigator.clipboard.writeText(kw.term);\\n    setCopiedKeywordId(kw.id);\\n    setTimeout(() => setCopiedKeywordId(null), 2000);\\n    showToast(`Copied keyword \\\"${kw.term}\\\" to clipboard.`);\\n  };\", \"TargetFile\":\"/src/components/reviewer/ResumeReviewerView.tsx\", \"toolAction\":\"Updating evaluation and recommendation handling in ResumeReviewerView.tsx\", \"toolSummary\":\"Update evaluation and recommendation handling\"}"
      thinking_signature: "\022\323\002\n\320\002\001i\024}\023\217\240\260\353Lq\"\360CT\036\363-e\302q\221\273\375+\252\225\021/\360\022C7C\211\030.Oo\371\022P\367fD\2614\334,\2146\321P\024\025\017\t\027L\362q\275\036\0229(\025\366\353\222\220v\3315~?\334\314\v\356g7\352\020]\036w\270\322\353\351CO\351W\216\035J\345=e-\351\325\273\254*Ub\367!\271\253\377\255E\323\300\0059\326\242\353\227\201\331\324\357\220p\376\003\326xZV\253t\226Xc}\004B-\021@t\032\212\343NYu\242\243\367\266\254>\322\224,\263\356\361v\230\346\034j\t\\\2405\r\177\2441\273`\037u\237\312 \237\035\036x\204\253=\"\230W\335c\341Z\020\r\203\277m/\256\\\375\226\005\217(\242\207\204P\364<\034\336\243ee\347\207\214v\210C\032@\267?\270G\227Y|\341\276\241\003\212\t]9G\a\220\361V\347\312/\004\311\333\363\216\f\221\214<E\345\006d1\252\270\342\00611g\217\360J\313)\027\263R\335\016\231Vn\217\317\333UH\325\324\360\000\232\3127\212\344\216\242\016\331\023\307\215\317\264\242\3006\005d\3069\366g\355\331]\313\340`F9\331\317k6\362\325o"
