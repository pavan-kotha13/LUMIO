            }
            lines {
              text: "    if (aboutWords >= 50 && aboutWords <= 250) aboutScore = 92;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    else if (aboutWords > 250) aboutScore = 84;"
