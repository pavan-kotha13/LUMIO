            lines {
              text: "    // 4. Experience & Project Optimizations with TruthGuard"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const experienceOptimizations = experience.flatMap((exp: any) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return (exp.bullets || []).map((bullet: string, bIdx: number) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const hasNumbers = /\\\\d+/.test(bullet);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let optimized = bullet.trim();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!/^[A-Z][a-z]+ed\\\\b/.test(optimized) && !/^[A-Z][a-z]+ing\\\\b/.test(optimized)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          optimized = `Architected and executed ${optimized.charAt(0).toLowerCase() + optimized.slice(1)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!hasNumbers) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          optimized = `${optimized}, enhancing operational efficiency and system maintainability across the engineering team`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          id: `opt_${exp.id}_${bIdx}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
