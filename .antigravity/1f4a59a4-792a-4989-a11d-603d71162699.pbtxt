  view_file {
    absolute_path_uri: "file:///src/types/index.ts"
    end_line: 187
    content: "/**\n * Resume Architect Core Domain Types\n * Clean, decoupled domain types prepared for FastAPI + SQLite + Gemini AI backend.\n */\n\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  avatarUrl?: string;\n  createdAt: string;\n}\n\nexport interface AuthState {\n  user: User | null;\n  isAuthenticated: boolean;\n  isLoading: boolean;\n  error: string | null;\n}\n\nexport interface LoginCredentials {\n  email: string;\n  password?: string;\n  rememberMe?: boolean;\n}\n\nexport interface SignupCredentials {\n  name: string;\n  email: string;\n  password?: string;\n  confirmPassword?: string;\n}\n\n/**\n * 6 Core Pillars of the Resume Architect Score Engine:\n * 1. Job Description Keyword Alignment\n * 2. Technical Skill Alignment\n * 3. Project Relevance\n * 4. Work Experience Relevance\n * 5. Education Relevance\n * 6. Resume Formatting & Readability\n */\nexport type ScoreCategoryId =\n  | \'keyword-alignment\'\n  | \'technical-skills\'\n  | \'project-relevance\'\n  | \'experience-relevance\'\n  | \'education-relevance\'\n  | \'formatting-readability\';\n\nexport interface ScoreCategory {\n  id: ScoreCategoryId;\n  name: string;\n  score: number; // 0 - 100\n  weight: number; // Decimal (e.g., 0.20)\n  status: \'optimal\' | \'moderate\' | \'action-required\';\n  summary: string;\n  metrics: {\n    matched: number;\n    total: number;\n    unit?: string;\n  };\n}\n\nexport interface MissingKeyword {\n  id: string;\n  term: string;\n  category: \'Critical Mandate\' | \'Technical Tool\' | \'Industry Practice\' | \'Leadership\';\n  jobFrequency: number;\n  importance: \'critical\' | \'important\' | \'beneficial\';\n}\n\nexport interface SkillGap {\n  id: string;\n  skillName: string;\n  category: string;\n  status: \'matched\' | \'partial\' | \'missing\';\n  requiredContext: string;\n  candidateEvidence: string | null;\n  recommendation: string;\n}\n\nexport interface ImprovementRecommendation {\n  id: string;\n  category: ScoreCategoryId;\n  title: string;\n  description: string;\n  priority: \'high\' | \'medium\' | \'low\';\n  estimatedScoreDelta: number; // Estimated points gained if addressed\n  sampleBefore?: string;\n  sampleAfter?: string;\n}\n\nexport interface ResumeScoreEvaluation {\n  id: string;\n  overallScore: number; // Calculated deterministically via weighted categories\n  scoreGrade: \'Exceptional\' | \'Strong\' | \'Competitive\' | \'Needs Revision\';\n  evaluatedAt: string;\n  jobTitle: string;\n  companyName?: string;\n  resumeFileName: string;\n  categories: ScoreCategory[];\n  missingKeywords: MissingKeyword[];\n  skillGaps: SkillGap[];\n  recommendations: ImprovementRecommendation[];\n  methodologyNotes: string;\n}\n\nexport interface ResumeItem {\n  id: string;\n  title: string;\n  targetJobTitle: string;\n  targetCompany?: string;\n  updatedAt: string;\n  createdAt: string;\n  version: string;\n  format: \'ATS Minimalist\' | \'Executive Modern\' | \'Technical Specialist\';\n  score?: number; // 0 - 100\n  scoreGrade?: \'Exceptional\' | \'Strong\' | \'Competitive\' | \'Needs Revision\';\n  pageCount: number;\n  wordCount: number;\n  tags: string[];\n  summarySnippet: string;\n}\n\nexport interface EducationEntry {\n  id: string;\n  institutionName: string;\n  degree: string;\n  branch: string;\n  startYear: string;\n  graduationYear: string;\n  cgpaOrPercentage: string;\n}\n\nexport interface SkillCategoryGroup {\n  programmingLanguages: string[];\n  frameworks: string[];\n  databases: string[];\n  developerTools: string[];\n  coreSubjects: string[];\n  otherSkills: string[];\n}\n\nexport interface ProjectEntry {\n  id: string;\n  projectName: string;\n  projectDescription: string;\n  technologiesUsed: string;\n  projectLink?: string;\n  keyContributions: string;\n  projectOutcome?: string;\n}\n\nexport interface ExperienceEntry {\n  id: string;\n  organisation: string;\n  jobTitle: string;\n  startDate: string;\n  endDate: string;\n  isCurrent?: boolean;\n  responsibilities: string;\n  keyAchievements?: string;\n}\n\nexport interface ResumeStudioData {\n  personalInfo: {\n    fullName: string;\n    email: string;\n    phone: string;\n    location: string;\n    linkedinUrl?: string;\n    githubUrl?: string;\n    portfolioUrl?: string;\n  };\n  careerObjective: {\n    targetJobRole: string;\n    targetIndustry: string;\n    professionalSummary: string;\n  };\n  education: EducationEntry[];\n  skills: SkillCategoryGroup;\n  projects: ProjectEntry[];\n  experience: ExperienceEntry[];\n}\n\n\n"
    num_lines: 188
    num_bytes: 4267
    line_range_bytes: 4267
  }
}
