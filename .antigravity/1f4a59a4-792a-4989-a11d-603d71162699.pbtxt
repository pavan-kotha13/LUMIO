xt-[#1C201D] transition-colors\\\">\\n                  Match vs. Prove Matrix\\n                </a>\\n              </li>\\n              <li>\\n                <a href=\\\"#pricing\\\" className=\\\"hover:text-[#1C201D] transition-colors\\\">\\n                  Pricing Plans\\n                </a>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          {/* Architecture Principles */}\\n          <div className=\\\"space-y-3\\\">\\n            <h4 className=\\\"text-xs font-semibold uppercase tracking-wider text-[#1C201D]\\\">\\n              Methodology\\n            </h4>\\n            <ul className=\\\"space-y-2 text-xs\\\">\\n              <li>\\n                <span className=\\\"text-[#57605A]\\\">Zero Keyword Stuffing</span>\\n              </li>\\n              <li>\\n                <span className=\\\"text-[#57605A]\\\">Mandate Deconstruction</span>\\n              </li>\\n              <li>\\n                <span className=\\\"text-[#57605A]\\\">Quantified Evidence Dockets</span>\\n              </li>\\n              <li>\\n                <span className=\\\"text-[#57605A]\\\">Hiring Decision Matrix</span>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          {/* Account & Access */}\\n          <div className=\\\"space-y-3\\\">\\n            <h4 className=\\\"text-xs font-semibold uppercase tracking-wider text-[#1C201D]\\\">Access</h4>\\n            <ul className=\\\"space-y-2 text-xs\\\">\\n              <li>\\n                <Link to=\\\"/login\\\" className=\\\"hover:text-[#1C201D] transition-colors\\\">\\n                  Candidate Sign In\\n                </Link>\\n              </li>\\n              <li>\\n                <Link to=\\\"/signup\\\" className=\\\"hover:text-[#1C201D] transition-colors\\\">\\n                  Create Workspace\\n                </Link>\\n              </li>\\n              <li>\\n                <span className=\\\"text-[#848E88]\\\">API Integration (FastAPI)</span>\\n              </li>\\n              <li>\\n                <span className=\\\"text-[#848E88]\\\">Gemini AI Blueprint Engine</span>\\n              </li>\\n            </ul>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"mt-12 pt-6 border-t border-[#E5E1D7] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#848E88]\\\">\\n          <p>\302\251 {new Date().getFullYear()} Resume Architect. All rights reserved.</p>\\n          <div className=\\\"flex items-center gap-4\\\">\\n            <span className=\\\"hover:text-[#57605A] transition-colors cursor-pointer\\\">\\n              Privacy Notice\\n            </span>\\n            <span>\302\267</span>\\n            <span className=\\\"hover:text-[#57605A] transition-colors cursor-pointer\\\">\\n              Terms of Service\\n            </span>\\n            <span>\302\267</span>\\n            <span className=\\\"hover:text-[#57605A] transition-colors cursor-pointer\\\">\\n              Security Standards\\n            </span>\\n          </div>\\n        </div>\\n      </div>\\n    </footer>\\n  );\\n};\\n\", \"Description\":\"Create quiet, elegant Footer component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/common/Footer.tsx\", \"toolAction\":\"Writing components/common/Footer.tsx\", \"toolSummary\":\"Create application footer\"}"
