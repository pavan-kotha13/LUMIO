      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ResumeItem } from \'../../types\';\\nimport { Input } from \'../common/Input\';\\nimport { Button } from \'../common/Button\';\\nimport { X, FilePlus, Sparkles, Check } from \'lucide-react\';\\n\\ninterface CreateResumeModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  onCreate: (data: Partial<ResumeItem>) => Promise<void>;\\n}\\n\\nexport const CreateResumeModal: React.FC<CreateResumeModalProps> = ({\\n  isOpen,\\n  onClose,\\n  onCreate,\\n}) => {\\n  const [title, setTitle] = useState(\'\');\\n  const [targetJobTitle, setTargetJobTitle] = useState(\'\');\\n  const [targetCompany, setTargetCompany] = useState(\'\');\\n  const [format, setFormat] = useState<ResumeItem[\'format\']>(\'ATS Minimalist\');\\n  const [tagsInput, setTagsInput] = useState(\'Go, Kubernetes, Cloud Architecture\');\\n  const [isSubmitting, setIsSubmitting] = useState(false);\\n\\n  if (!isOpen) return null;\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!title.trim() || !targetJobTitle.trim()) return;\\n\\n    setIsSubmitting(true);\\n    try {\\n      const tags = tagsInput\\n        .split(\',\')\\n        .map((t) => t.trim())\\n        .filter(Boolean);\\n\\n      await onCreate({\\n        title: title.trim(),\\n        targetJobTitle: targetJobTitle.trim(),\\n        targetCompany: targetCompany.trim(),\\n        format,\\n        tags,\\n        score: 75,\\n        scoreGrade: \'Strong\',\\n        summarySnippet: `Executive candidate dossier targeted specifically for ${targetJobTitle.trim()}${\\n          targetCompany ? ` at ${targetCompany.trim()}` : \'\'\\n        }.`,\\n      });\\n      onClose();\\n    } finally {\\n      setIsSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xs\\\">\\n      <div className=\\\"bg-white rounded-3xl border border-[#E5E1D7] max-w-xl w-full p-6 sm:p-8 shadow-elevated space-y-6\\\">\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-[#F0ECE1]\\\">\\n          <div className=\\\"space-y-1\\\">\\n            <h3 className=\\\"text-xl font-bold text-[#1C201D] flex items-center gap-2\\\">\\n              <FilePlus className=\\\"w-5 h-5 text-[#1B4332]\\\" />\\n              <span>Create New Tailored Resume</span>\\n            </h3>\\n            <p className=\\\"text-xs text-[#57605A]\\\">\\n              Configure your document format and target role to begin drafting.\\n            </p>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1.5 text-[#57605A] hover:text-[#1C201D] hover:bg-[#FAF8F5] rounded-lg transition-colors cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"space-y-4\\\">\\n          <Input\\n            label=\\\"Resume Document Title\\\"\\n            type=\\\"text\\\"\\n            placeholder=\\\"e.g. Staff Distributed Systems Architect \342\200\224 v1\\\"\\n            value={title}\\n            onChange={(e) => setTitle(e.target.value)}\\n            required\\n          />\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <Input\\n              label=\\\"Target Role Title\\\"\\n              type=\\\"text\\\"\\n              placeholder=\\\"e.g. Staff Systems Engineer\\\"\\n              value={targetJobTitle}\\n              onChange={(e) => setTargetJobTitle(e.target.value)}\\n              required\\n            />\\n            <Input\\n              label=\\\"Target Company (Optional)\\\"\\n              type=\\\"text\\\"\\n              placeholder=\\\"e.g. Stripe, Datadog\\\"\\n              value={targetCompany}\\n              onChange={(e) => setTargetCompany(e.target.value)}\\n            />\\n          </div>\\n\\n          <div className=\\\"space-y-1.5\\\">\\n            <label className=\\\"block text-xs font-semibold text-[#1C201D]\\\">\\n              Resume Layout Architecture\\n            </label>\\n            <div className=\\\"grid grid-cols-3 gap-2\\\">\\n              {(\\n                [\'ATS Minimalist\', \'Executive Modern\', \'Technical Specialist\'] as ResumeItem[\'format\'][]\\n              ).map((f) => (\\n                <button\\n                  key={f}\\n                  type=\\\"button\\\"\\n                  onClick={() => setFormat(f)}\\n                  className={`p-3 rounded-xl border text-left transition-all cursor-pointer ${\\n                    format === f\\n                      ? \'border-[#1B4332] bg-[#EBF2EC] text-[#1B4332] font-semibold\'\\n                      : \'border-[#E5E1D7] bg-white text-[#57605A] hover:bg-[#FAF8F5]\'\\n                  }`}\\n                >\\n                  <span className=\\\"text-xs block leading-tight\\\">{f}</span>\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          <Input\\n            label=\\\"Key Competency Tags (Comma Separated)\\\"\\n            type=\\\"text\\\"\\n            placeholder=\\\"Go, Kubernetes, Distributed Systems, SLA\\\"\\n            value={tagsInput}\\n            onChange={(e) => setTagsInput(e.target.value)}\\n          />\\n\\n          <div className=\\\"flex items-center justify-end gap-2.5 pt-4 border-t border-[#F0ECE1]\\\">\\n            <Button type=\\\"button\\\" variant=\\\"ghost\\\" size=\\\"sm\\\" onClick={onClose}>\\n              Cancel\\n            </Button>\\n            <Button\\n              type=\\\"submit\\\"\\n              variant=\\\"primary\\\"\\n              size=\\\"md\\\"\\n              isLoading={isSubmitting}\\n              leftIcon={<Check className=\\\"w-4 h-4\\\" />}\\n            >\\n              Create Resume Draft\\n            </Button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create CreateResumeModal for adding new resumes to history\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/CreateResumeModal.tsx\", \"toolAction\":\"Writing components/dashboard/CreateResumeModal.tsx\", \"toolSummary\":\"Create new resume modal\"}"
      thinking_signature: "\022\322\f\n\317\f\001i\024}\023\326\037\210r\255\221\200\365\002`\f\021\n\215O\357\235O\362\250+5W&\270QM\262Gsl\322\376\357\300dY\331\'\341C\204Fk:#\342|&\321@\206\r\3513\316~>\2316\341\210\307\243l\264\f7\336\366\026\363\b/J\273\256\216\250\265\027\304:\347?\t\311*2T\303\261\247t\321N\302u^\">\307\333q\203\371\277\220\265\036da\251x\320\307\220\033\v\246\236;\212\233\260\332\003\270\300_\031\322\3715]\006+\027\223\317%\257ft>\232\347\350\221n\336\336\364\365F\325\370\036\025\337\021\337|A\230\325\\\177K\246\r\000\305W\213\345\334\350\025:\235T\375\\\307b\272EiGY\352\207\n\210\'\b&\342\320@\206\247g\300\230\000\317\260\213\242&\207\245A\261\031w\030)\"A\246\335\266a\033T\000\b[zV\263\026=\331-}\200\n\273\016\264\017J7z\207\316\273<\234\240\206\246\326\3470w\303\232X\267\245ga\a}\027tn\273H\027{\017\373\315\242\223\321z\355\324\2133\360 \230\311\231!s\271\270E\257\2059\203\200\234~b\026\273\220\205c.c\vZ\37764]\322)\223c\322\212\023J\360\032\213\231a\206\254\242N\216W\345\331\267\306\276\035\202\261\356\222\216\b\251\005)\353va\217QI\271\315\314\303\226@\355P\253\a\005b\001[\204\261%?\371;>\226x\354TR\224\036u\302SE\353\304\250\311\222\364B&\b\255\257\300\310\276\347\2473kv\270\371\212\232>\327\214\271\334\344\032\023\321\024a\361\333dQ\374aNr\361\334\355\\\316>;BG\246FM\330(r*\357-zo\a\\\332\2562\312\2534iL\244\353\253\361a\347v\036=B!\205\003P[\020\333?\275O\274i\026\177\321\231\231\300h\255\030\315X1\345\006\227L\241\263\264\312\244\363\372\177r\271P^\350\035\000\301\244\2710\377f\325\234\004\332\375TW\261\033\226\373\024-\260~O\227Zh\202\376\261\335\374\036Y\341?1fm\233H\b\233\362\365\261\306\320\276\216\212k\274\256.\224G\374\367\232\334\275\253n\006\256!\331\034\n\024\260\364=\036\211lxY\340\016^4\235\275k\2041\372\366 \\D\326\336|\310\203\317\212D\260\016\375\273!\2777\202\035!\232\223\177\217\274\304`\321u\341\355J\216\214`\224\216(\203\245\006\226\315\005\326\271\276\355!\362,q\267.!\\\201\034q-LEh\253\224\004OF\204\216\336\341?M