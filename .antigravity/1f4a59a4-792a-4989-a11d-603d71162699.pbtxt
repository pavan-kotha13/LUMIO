  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { RoleComparisonPreset } from \'../../types\';\nimport { Check, X, ArrowRight, Layers, BarChart3, Award, Sparkles, Building2 } from \'lucide-react\';\nimport { Button } from \'../common/Button\';\nimport { Link } from \'react-router-dom\';\n\nconst ROLE_PRESETS: RoleComparisonPreset[] = [\n  {\n    id: \'eng-lead\',\n    roleTitle: \'Staff / Principal Systems Architect\',\n    targetCompanyType: \'Series C Fintech / High Concurrency\',\n    jobRequirement:\n      \'Must have demonstrated experience leading legacy monolith migrations into distributed cloud architectures with zero downtime and sub-10ms p99 latency SLA guarantees.\',\n    naiveResumeBullet:\n      \'Responsible for microservices architecture and cloud migration. Collaborated with DevOps engineers to improve backend performance and implement distributed systems best practices.\',\n    architectBullet:\n      \'Architected event-driven decoupling of core payment ledger into 18 Go microservices on EKS; sustained 99.999% uptime across 8.4M peak daily transactions while slashing p99 latency from 142ms to 6.8ms.\',\n    fitDelta: \'+280% Recruiter Conviction\',\n    proofMetrics: [\n      { label: \'Scale Verified\', value: \'8.4M daily txns\' },\n      { label: \'Reliability Evidence\', value: \'99.999% SLA\' },\n      { label: \'Performance Delta\', value: \'-95% latency\' },\n    ],\n  },\n  {\n    id: \'product-lead\',\n    roleTitle: \'Director / VP of Product Management\',\n    targetCompanyType: \'Enterprise B2B SaaS ($20M-$80M ARR)\',\n    jobRequirement:\n      \'Proven track record scaling enterprise product offerings from pilot to multi-million ARR contracts, establishing cross-functional product governance and reducing customer churn.\',\n    naiveResumeBullet:\n      \'Managed enterprise SaaS roadmap and worked closely with sales and customer success teams to launch key enterprise features, increasing user retention and driving new customer acquisition.\',\n    architectBullet:\n      \'Spearheaded enterprise compliance tier (SOC2 Type II, RBAC, Audit Logging) from concept to launch in 5 months; unlocked $14.2M in blocked enterprise pipeline and lowered net churn from 11% to 2.8%.\',\n    fitDelta: \'+340% Recruiter Conviction\',\n    proofMetrics: [\n      { label: \'Pipeline Unlocked\', value: \'$14.2M new ARR\' },\n      { label: \'Time-to-Market\', value: \'5 months flat\' },\n      { label: \'Churn Reduction\', value: \'11% \342\206\222 2.8%\' },\n    ],\n  },\n  {\n    id: \'growth-lead\',\n    roleTitle: \'Head of Growth & Performance Marketing\',\n    targetCompanyType: \'Direct-to-Consumer / Global Marketplace\',\n    jobRequirement:\n      \'Demonstrated expertise restructuring multi-channel ad spend, engineering organic attribution loops, and scaling monthly GMV efficiently amid iOS privacy headwinds.\',\n    naiveResumeBullet:\n      \'Oversaw digital marketing budgets across Meta, Google, and TikTok. Implemented attribution tracking and improved customer acquisition costs for key product lines.\',\n    architectBullet:\n      \'Engineered first-party server-side attribution pipeline across $18M annual ad spend; reclaimed 34% in misattributed Meta conversions and compressed blended CAC by 41% while scaling monthly GMV to $9.2M.\',\n    fitDelta: \'+310% Recruiter Conviction\',\n    proofMetrics: [\n      { label: \'Capital Deployed\', value: \'$18M ad spend\' },\n      { label: \'CAC Efficiency\', value: \'-41% blended CAC\' },\n      { label: \'Volume Scaled\', value: \'$9.2M / mo GMV\' },\n    ],\n  },\n];\n\nexport const InteractiveProofSandbox: React.FC = () => {\n  const [activePresetIndex, setActivePresetIndex] = useState(0);\n  const [showInspection, setShowInspection] = useState(false);\n\n  const current = ROLE_PRESETS[activePresetIndex];\n\n  return (\n    <section id=\"proof-engine\" className=\"py-12 md:py-16 scroll-mt-20\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"max-w-3xl mb-10\">\n          <p className=\"text-xs font-semibold tracking-wider uppercase text-[#1B4332] mb-2\">\n            The Evidence Engine in Action\n          </p>\n          <h2 className=\"text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[#1C201D] [text-wrap:balance]\">\n            Keyword matching gets you in the database.{\' \'}\n            <span className=\"text-[#1B4332]\">Defensible proof gets you hired.</span>\n          </h2>\n          <p className=\"mt-3 text-sm sm:text-base text-[#57605A] max-w-2xl\">\n            See how Resume Architect transforms passive keyword regurgitation into definitive proof\n            dockets calibrated for senior decision-makers.\n          </p>\n        </div>\n\n        {/* Role Selector Tabs (Interactive filter control - button elements allowed) */}\n        <div className=\"flex flex-wrap items-center gap-2 p-1.5 bg-[#F3EFE7] rounded-xl border border-[#E5E1D7] max-w-3xl mb-8\">\n          {ROLE_PRESETS.map((preset, idx) => (\n            <button\n              key={preset.id}\n              onClick={() => {\n                setActivePresetIndex(idx);\n                setShowInspection(false);\n              }}\n              className={`px-4 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all duration-150 whitespace-nowrap cursor-pointer ${\n                activePresetIndex === idx\n                  ? \'bg-white text-[#1C201D] shadow-sm font-semibold\'\n                  : \'text-[#57605A] hover:text-[#1C201D] hover:bg-white/50\'\n              }`}\n            >\n              {preset.roleTitle.split(\'/\')[0].trim()}\n            </button>\n          ))}\n        </div>\n\n        {/* The Live Proof Canvas */}\n        <div className=\"bg-white rounded-2xl border border-[#E5E1D7] shadow-card overflow-hidden\">\n          {/* Top context strip */}\n          <div className=\"bg-[#FAF8F5] px-6 py-4 border-b border-[#E5E1D7] flex flex-col md:flex-row md:items-center justify-between gap-3\">\n            <div className=\"space-y-0.5\">\n              <div className=\"flex items-center gap-2 text-xs text-[#57605A]\">\n                <Building2 className=\"w-3.5 h-3.5 text-[#1B4332]\" />\n                <span className=\"font-semibold text-[#1C201D]\">{current.roleTitle}</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>{current.targetCompanyType}</span>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-xs font-semibold text-[#1B4332] bg-[#EBF2EC] px-3 py-1 rounded-md\">\n                {current.fitDelta}\n              </span>\n              <button\n                onClick={() => setShowInspection(!showInspection)}\n                className=\"text-xs font-medium text-[#1B4332] hover:underline cursor-pointer\"\n              >\n                {showInspection ? \'Hide Anatomy\' : \'Inspect Proof Anatomy\'}\n              </button>\n            </div>\n          </div>\n\n          {/* Job Requirement Card */}\n          <div className=\"p-6 border-b border-[#E5E1D7] bg-[#FCFBF8]\">\n            <span className=\"text-xs font-semibold tracking-wider uppercase text-[#848E88] block mb-2\">\n              Hiring Manager\'s Explicit Mandate\n            </span>\n            <p className=\"text-sm md:text-base text-[#1C201D] font-medium leading-relaxed italic\">\n              \"{current.jobRequirement}\"\n            </p>\n          </div>\n\n          {/* Side by Side Comparison Grid */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-[#E5E1D7]\">\n            {/* Left: The Naive Keyword Match (The Status Quo) */}\n            <div className=\"p-6 sm:p-8 space-y-4 bg-white\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-semibold text-[#8C2E2E] tracking-wider uppercase flex items-center gap-1.5\">\n                  <X className=\"w-3.5 h-3.5 text-[#8C2E2E]\" />\n                  Generic AI Keyword Match\n                </span>\n                <span className=\"text-xs text-[#848E88]\">High keywords \302\267 0 proof</span>\n              </div>\n\n              <div className=\"p-4 rounded-xl bg-[#FAF9F7] border border-[#EAE6DC] text-sm text-[#57605A] leading-relaxed\">\n                \"{current.naiveResumeBullet}\"\n              </div>\n\n              <div className=\"space-y-2 pt-2\">\n                <span className=\"text-xs font-medium text-[#848E88] block\">Why This Fails:</span>\n                <ul className=\"text-xs text-[#57605A] space-y-1.5\">\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#8C2E2E] font-bold\">\342\234\225</span>\n                    <span>Merely restates job description keywords (\"microservices\", \"cloud\").</span>\n                  </li>\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#8C2E2E] font-bold\">\342\234\225</span>\n                    <span>Zero quantifiable scale, no business stakes, no verifiable ownership.</span>\n                  </li>\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#8C2E2E] font-bold\">\342\234\225</span>\n                    <span>Recruiters skim past in 4 seconds; blends into 400 competing applicants.</span>\n                  </li>\n                </ul>\n              </div>\n            </div>\n\n            {/* Right: The Resume Architect Evidence Docket */}\n            <div className=\"p-6 sm:p-8 space-y-4 bg-[#FAFDFB]\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-semibold text-[#1B4332] tracking-wider uppercase flex items-center gap-1.5\">\n                  <Check className=\"w-3.5 h-3.5 text-[#1B4332]\" />\n                  Resume Architect Verified Proof\n                </span>\n                <span className=\"text-xs font-medium text-[#1B4332] bg-[#EBF2EC] px-2 py-0.5 rounded\">\n                  Substantiated Impact\n                </span>\n              </div>\n\n              <div className=\"p-4 rounded-xl bg-white border border-[#D5E3DA] text-sm text-[#1C201D] font-medium leading-relaxed shadow-sm\">\n                \"{current.architectBullet}\"\n              </div>\n\n              {/* Proof metrics row */}\n              <div className=\"grid grid-cols-3 gap-2 pt-2\">\n                {current.proofMetrics.map((metric, i) => (\n                  <div key={i} className=\"p-2.5 rounded-lg bg-white border border-[#D5E3DA]\">\n                    <span className=\"text-[11px] text-[#57605A] block leading-tight\">\n                      {metric.label}\n                    </span>\n                    <span className=\"text-xs font-bold text-[#1B4332] tabular-nums mt-0.5 block\">\n                      {metric.value}\n                    </span>\n                  </div>\n                ))}\n              </div>\n\n              <div className=\"space-y-2 pt-2\">\n                <span className=\"text-xs font-medium text-[#1B4332] block\">Why This Wins:</span>\n                <ul className=\"text-xs text-[#394B40] space-y-1.5\">\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#1B4332] font-bold\">\342\234\223</span>\n                    <span>Proves exact execution capability with hard engineering/business metrics.</span>\n                  </li>\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#1B4332] font-bold\">\342\234\223</span>\n                    <span>Answers the implicit fear: \"Can this candidate handle our specific scale?\"</span>\n                  </li>\n                  <li className=\"flex items-start gap-2\">\n                    <span className=\"text-[#1B4332] font-bold\">\342\234\223</span>\n                    <span>Immediately passes recruiter screening and triggers hiring manager deep dive.</span>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n\n          {/* Proof Anatomy Inspector Drawer (Optional deep-dive) */}\n          {showInspection && (\n            <div className=\"bg-[#FAF8F5] p-6 border-t border-[#E5E1D7] transition-all\">\n              <h4 className=\"text-xs font-semibold uppercase tracking-wider text-[#1C201D] mb-3\">\n                The 3 Pillars of an Architect Proof Point\n              </h4>\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n                <div className=\"p-4 bg-white rounded-xl border border-[#E5E1D7] space-y-1\">\n                  <span className=\"font-bold text-[#1B4332]\">1. Scope & System Complexity</span>\n                  <p className=\"text-[#57605A]\">\n                    Explicit boundary conditions (e.g. 18 microservices, $18M ad spend, multi-region).\n                  </p>\n                </div>\n                <div className=\"p-4 bg-white rounded-xl border border-[#E5E1D7] space-y-1\">\n                  <span className=\"font-bold text-[#1B4332]\">2. Technical / Strategic Lever</span>\n                  <p className=\"text-[#57605A]\">\n                    The exact decision you made (e.g. event-driven decoupling, server-side attribution).\n                  </p>\n                </div>\n                <div className=\"p-4 bg-white rounded-xl border border-[#E5E1D7] space-y-1\">\n                  <span className=\"font-bold text-[#1B4332]\">3. Verifiable Business Delta</span>\n                  <p className=\"text-[#57605A]\">\n                    Quantified outcome with units and timeframe (e.g. 99.999% SLA, -41% CAC).\n                  </p>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Bottom Action Footer */}\n          <div className=\"px-6 py-4 bg-[#F7F5EE] border-t border-[#E5E1D7] flex flex-col sm:flex-row items-center justify-between gap-4\">\n            <p className=\"text-xs text-[#57605A]\">\n              Ready to generate verified proof arguments for your own career achievements?\n            </p>\n            <Link to=\"/signup\">\n              <Button size=\"sm\" variant=\"primary\" rightIcon={<ArrowRight className=\"w-3.5 h-3.5\" />}>\n                Architect Your Resume Now\n              </Button>\n            </Link>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/landing/InteractiveProofSandbox.tsx"
        }
        overwrite: true
      }
    }
