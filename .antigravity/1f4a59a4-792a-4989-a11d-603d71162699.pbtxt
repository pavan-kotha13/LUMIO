              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Four Core Capabilities"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **AI Resume Score Engine**: Analyse resumes against job descriptions and calculate a transparent match score."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Resume Builder**: Create ATS-conscious resumes using candidate information."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Resume Reviewer**: Identify skill gaps, missing keywords and formatting issues."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **LinkedIn Optimizer**: Improve LinkedIn headlines, About sections, experience and skills."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 4. Score Engine Architecture (6 Evaluation Pillars)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "The future scoring engine deterministically calculates overall match scores using transparent weighted categories (no hallucinated random numbers):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Job Description Keyword Alignment (25%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Technical Skill Alignment (25%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Work Experience Relevance (20%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Project Relevance (15%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Resume Formatting & Readability (10%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Education Relevance (5%)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "$$\\text{Overall Score} = \\sum (\\text{Category Score} \\times \\text{Weight})$$"
