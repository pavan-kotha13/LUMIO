  code_action {
    action_spec {
      create_file {
        instruction: "import { User, LoginCredentials, SignupCredentials } from \'../types\';\n\nconst STORAGE_KEY_USER = \'resume_architect_user\';\nconst STORAGE_KEY_TOKEN = \'resume_architect_token\';\n\n/**\n * Service for managing authentication.\n * Ready to connect directly to FastAPI `/api/v1/auth/login` and `/api/v1/auth/register`.\n */\nexport const authService = {\n  async login(credentials: LoginCredentials): Promise<{ user: User; token: string }> {\n    // Artificial latency for realistic responsive feedback\n    await new Promise((resolve) => setTimeout(resolve, 600));\n\n    // Client-side authentication persistence\n    const user: User = {\n      id: \'usr_\' + Math.random().toString(36).substring(2, 9),\n      name: credentials.email.split(\'@\')[0].replace(/[._]/g, \' \').replace(/\\b\\w/g, (c) => c.toUpperCase()) || \'Candidate\',\n      email: credentials.email,\n      targetRole: \'Staff Software Architect\',\n      seniority: \'Lead\',\n      createdAt: new Date().toISOString(),\n    };\n\n    const token = \'jwt_\' + Math.random().toString(36).substring(2) + Date.now().toString(36);\n\n    localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));\n    localStorage.setItem(STORAGE_KEY_TOKEN, token);\n\n    return { user, token };\n  },\n\n  async signup(credentials: SignupCredentials): Promise<{ user: User; token: string }> {\n    await new Promise((resolve) => setTimeout(resolve, 750));\n\n    const user: User = {\n      id: \'usr_\' + Math.random().toString(36).substring(2, 9),\n      name: credentials.name || \'Executive Candidate\',\n      email: credentials.email,\n      targetRole: credentials.targetRole || \'Senior Engineering Leader\',\n      seniority: (credentials.seniority as User[\'seniority\']) || \'Senior\',\n      createdAt: new Date().toISOString(),\n    };\n\n    const token = \'jwt_\' + Math.random().toString(36).substring(2) + Date.now().toString(36);\n\n    localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));\n    localStorage.setItem(STORAGE_KEY_TOKEN, token);\n\n    return { user, token };\n  },\n\n  async logout(): Promise<void> {\n    localStorage.removeItem(STORAGE_KEY_USER);\n    localStorage.removeItem(STORAGE_KEY_TOKEN);\n  },\n\n  getCurrentUser(): User | null {\n    try {\n      const stored = localStorage.getItem(STORAGE_KEY_USER);\n      return stored ? JSON.parse(stored) : null;\n    } catch {\n      return null;\n    }\n  },\n\n  getToken(): string | null {\n    return localStorage.getItem(STORAGE_KEY_TOKEN);\n  },\n};\n"
        path {
