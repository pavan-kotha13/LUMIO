    content: ")\n\n# Mount API Routers under /api\napp.include_router(auth.router)\napp.include_router(resumes.router)\napp.include_router(analysis.router)\napp.include_router(editor.router)\napp.include_router(linkedin.router)\n\n# Mount API Routers under /api/v1 for versioned clients\napp.include_router(auth.router, prefix=\"/api/v1/auth\".replace(\"/api/auth\", \"\"))\napp.include_router(resumes.router, prefix=\"/api/v1/resumes\".replace(\"/api/resumes\", \"\"))\napp.include_router(analysis.router, prefix=\"/api/v1/analysis\".replace(\"/api/analysis\", \"\"))\napp.include_router(editor.router, prefix=\"/api/v1/resumes\".replace(\"/api/resumes\", \"\"))\napp.include_router(linkedin.router, prefix=\"/api/v1/linkedin\".replace(\"/api/linkedin\", \"\"))\n\n@app.get(\"/api/health\")\n@app.get(\"/api/v1/health\")\ndef health_check():\n    return {\n        \"status\": \"healthy\",\n        \"service\": \"Resume Architect FastAPI Backend\",\n        \"version\": \"1.0.0\"\n    }\n\n# Gemini helper endpoints for direct frontend studio calls"
